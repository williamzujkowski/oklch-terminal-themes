{
  "ci": {
    "collect": {
      "staticDistDir": "./.lighthouse-root",
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "skipAudits": ["bf-cache", "uses-http2"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "warn",
          {
            "minScore": 0.9
          }
        ],
        "aria-hidden-focus": "error",
        "heading-order": "error",
        "target-size": "error",
        "aria-valid-attr-value": "error",
        "color-contrast": "off",
        "csp-xss": "off",
        "is-crawlable": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
