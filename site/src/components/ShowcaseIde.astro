---
import { sourceRoleStyle, type SpecimenRole } from '@/lib/specimen-roles';
export interface Props { pane?: string }
const { pane = 'b' } = Astro.props;
const token = (text: string, role: SpecimenRole = 'body') => ({ text, role });
// An illustrative file, not this repository's implementation or build status.
const lines = [
  [token('// Plan a small review session.', 'comment')],
  [token('type ', 'keyword'), token('Task', 'type'), token(' = { label: ', 'punctuation'), token('string', 'type'), token('; minutes: ', 'punctuation'), token('number', 'type'), token(' };', 'punctuation')],
  [token('const ', 'keyword'), token('tasks: '), token('Task', 'type'), token('[] = [', 'punctuation')],
  [token('  { label: ', 'punctuation'), token('"Review palette"', 'string'), token(', minutes: ', 'punctuation'), token('"20"', 'error'), token(' },', 'punctuation')],
  [token('  { label: ', 'punctuation'), token('"Write notes"', 'string'), token(', minutes: ', 'punctuation'), token('10', 'number'), token(' },', 'punctuation')],
  [token('];', 'punctuation')],
  [token('const total = tasks.reduce(', 'current-line')],
  [token('  (sum, task) => sum + task.minutes,')],
  [token('  '), token('0', 'number'), token(',', 'punctuation')],
  [token(');', 'punctuation')],
  [token('const ', 'keyword'), token('previewOnly = '), token('total', 'selection'), token(';', 'punctuation')],
  [token('console.info('), token('"', 'string'), token('Planned minutes', 'search'), token(':"', 'string'), token(', total);', 'punctuation')],
];
const diagnosticsId = `${pane}-editor-diagnostics`;
---
<section class="showcase-section" aria-label={`${pane.toUpperCase()} · Editor specimen`} data-specimen="editor">
  <header><h3>Editor</h3><p>A controlled syntax mapping, not an upstream editor configuration.</p></header>
  <div class="ide" data-preview-surface data-role="body" style={sourceRoleStyle('body')}>
    <aside class="ide-tree" aria-label={`${pane.toUpperCase()} · Example files`} data-role="muted" style={sourceRoleStyle('muted')}>
      <p>review-session</p>
      <ul><li aria-current="page"><strong>sample.ts</strong></li><li>notes.md</li><li>settings.json</li></ul>
    </aside>
    <div class="ide-main">
      <div class="ide-tabs" role="group" aria-label="Example open files">
        <span data-editor-tab="active" style={sourceRoleStyle('body')}>sample.ts <span class="tab-note">active</span></span>
        <span data-editor-tab="inactive" data-role="muted" style={sourceRoleStyle('muted')}>notes.md</span>
      </div>
      <div class="ide-code" role="group" aria-label="Illustrative TypeScript source">
        {lines.map((tokens, index) => (
          <div class="code-line" data-code-line={index + 1} data-editor-state={index === 6 ? 'current-line' : undefined} data-role={index === 6 ? 'current-line' : undefined} style={index === 6 ? sourceRoleStyle('current-line') : undefined}>
            <span class="line-number" data-role="gutter" style={sourceRoleStyle('gutter')} aria-hidden="true">{index === 6 ? '▸' : index + 1}</span>
            <code>{tokens.map((part) => <span data-role={part.role} style={sourceRoleStyle(part.role)}>{part.text}</span>)}</code>
          </div>
        ))}
      </div>
      <div class="ide-diagnostics" id={diagnosticsId} role="group" aria-label="Illustrative diagnostics">
        <p data-role="error" style={sourceRoleStyle('error')}><span aria-hidden="true">×</span> Error, line 4: minutes expects a number; “20” is a string.</p>
        <p data-role="warning" style={sourceRoleStyle('warning')}><span aria-hidden="true">!</span> Warning, line 11: previewOnly is declared but never read.</p>
      </div>
      <footer class="ide-status" data-role="comment" style={sourceRoleStyle('comment')}>
        <span>TypeScript sample · 12 lines</span>
        <a href={`#${diagnosticsId}`} data-role="focus" style={sourceRoleStyle('focus')}>Review sample diagnostics</a>
      </footer>
    </div>
  </div>
  <p class="mapping-note">The arrow marks the current line. Highlighted text shows selection and a search match; diagnostics are illustrative.</p>
</section>
<style>
  .showcase-section { border: 1px solid var(--border); border-radius: .75rem; background: var(--surface); padding: 1rem; display: grid; gap: .75rem; min-width: 0; }
  header { display: flex; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
  h3, header p, .mapping-note { margin: 0; font-size: .875rem; line-height: 1.5; }
  .ide { display: grid; grid-template-columns: minmax(7.5rem,.28fr) minmax(0,1fr); border-radius: .5rem; overflow: hidden; color-scheme: var(--tt-color-scheme,normal); font: var(--specimen-size,14px)/1.6 var(--font-mono); min-width: 0; }
  .ide-tree { padding: .8em; border-inline-end: 1px solid currentColor; min-width: 0; overflow-wrap: anywhere; }
  .ide-tree p { margin: 0 0 .75em; }
  .ide-tree ul { list-style: none; padding: 0; margin: 0; }
  .ide-tree li { padding: .2em 0; }
  .ide-tree [aria-current] { text-decoration: underline; text-underline-offset: .3em; }
  .ide-main { min-width: 0; }
  .ide-tabs { display: flex; flex-wrap: wrap; gap: .2em; border-block-end: 1px solid currentColor; }
  .ide-tabs > span { padding: .45em .7em; }
  .ide-tabs [data-editor-tab='active'] { font-weight: 700; border-block-start: 2px solid currentColor; }
  .tab-note { font-weight: 400; }
  .ide-code { min-height: 20em; padding: .75em .5em; }
  .code-line { display: grid; grid-template-columns: 2.5ch minmax(0,1fr); gap: .7em; min-height: 1.6em; }
  .code-line[data-editor-state='current-line'] { box-shadow: inset 2px 0 currentColor; }
  .line-number { text-align: end; user-select: none; }
  .code-line code { font: inherit; white-space: pre-wrap; overflow-wrap: anywhere; }
  .ide-diagnostics { padding: .6em .8em; border-block-start: 1px solid currentColor; }
  .ide-diagnostics p { margin: .25em 0; overflow-wrap: anywhere; }
  .ide-status { padding: .55em .8em; display: flex; flex-wrap: wrap; gap: .5em 1em; }
  .ide-status a { text-underline-offset: .2em; }
  .ide-status a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
  .ide ::selection { color: var(--role-selection-fg,var(--tt-foreground)); background: var(--role-selection-bg,var(--tt-selection)); }
  @media(max-width: 40rem) { .ide { grid-template-columns: minmax(0,1fr); } .ide-tree { border-inline-end: 0; border-block-end: 1px solid currentColor; } .ide-tree ul { display: flex; flex-wrap: wrap; gap: .4em 1em; } .ide-tree p { margin-bottom: .2em; } }
</style>
