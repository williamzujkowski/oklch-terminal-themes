---
import dracula from '@williamzujkowski/oklch-terminal-themes/themes/dracula.json';
import { CHART_ACTIVITIES, CHART_LINES, SEQUENTIAL_VALUES, DIVERGING_VALUES, chartLinePoints, chartPresentation } from '@/lib/chart-paint';
import type { ChartDiagnosticTheme } from '@/lib/chart-diagnostics';
interface Props { theme?: ChartDiagnosticTheme; pane?: string; selectedSeries?: number }
const { theme = dracula, pane = 'b', selectedSeries = 0 } = Astro.props;
const model = chartPresentation(theme);
const vars = Object.entries(model.css).map(([name, value]) => `${name}:${value}`).join(';');
const selected = Number.isInteger(selectedSeries) && selectedSeries >= 0 && selectedSeries < 6 ? selectedSeries : 0;
const activity = CHART_ACTIVITIES[selected]!;
const ramps = [
  { group: 'sequential' as const, title: 'Sequential · ordered sample values', labels: SEQUENTIAL_VALUES },
  { group: 'diverging' as const, title: 'Diverging · baseline at the center', labels: DIVERGING_VALUES },
];
---
<section class="showcase-section" aria-label="Dataviz palette" data-specimen="dataviz" data-chart-specimen data-chart-pane={pane} data-chart-status={model.diagnostics.status} style={vars}>
  <header><h3>Dataviz</h3><p>Derived chart palettes; identical illustrative data in both panes.</p></header>
  <p class="chart-note">Charts use the source OKLCH colors, independently of application mappings. Canonical sRGB diagnostics below measure their hex fallbacks, not resolved CSS or a physical display. Six-normal-ANSI CVD tags do not certify these chart palettes.</p>
  <div data-chart-content hidden={model.diagnostics.status !== 'available'}>
    <figure class="chart-surface" data-preview-surface>
      <figcaption>Illustrative activity hours</figcaption>
      <ol class="viz-chart">
        {CHART_ACTIVITIES.map((row, i) => <li>
          <span class="bar-track"><span class="viz-bar" data-viz-bar={i} data-chart-bar={i} data-selected={String(i === selected)} style={`--viz-color:var(--chart-color-${i});height:${row.value / 80 * 100}%`}></span></span>
          <span class="bar-label">{row.marker} {row.label}</span><strong>{row.value} h</strong>
        </li>)}
      </ol>
    </figure>
    <div class="series-controls" role="group" aria-label="Select the same activity in both previews">
      {CHART_ACTIVITIES.map((row, i) => <button type="button" data-select-series={i} aria-pressed={i === selected}>{row.marker} {row.label}</button>)}
    </div>
    <p class="chart-note" data-chart-selected data-selected-series>Selected: {activity.label} · {activity.value} illustrative hours</p>
    <figure class="chart-surface" data-preview-surface>
      <figcaption>Two illustrative plans · weeks 1–6</figcaption>
      <p class="line-legend">○ Plan A · solid line / □ Plan B · dashed line</p>
      <svg viewBox="0 0 300 160" aria-hidden="true" class="line-chart">
        <path d="M24 20V140H280" fill="none" stroke="currentColor" stroke-width="1" />
        {CHART_LINES.map((line, series) => <g style={`color:var(--chart-color-${series})`}>
          <polyline points={chartLinePoints(line.values)} fill="none" stroke="currentColor" stroke-width="3" stroke-dasharray={line.dash} />
          {line.values.map((value, i) => series === 0 ? <circle cx={24 + i * 48} cy={140 - value * 1.4} r="4" fill="currentColor" /> : <rect x={20 + i * 48} y={136 - value * 1.4} width="8" height="8" fill="currentColor" />)}
        </g>)}
      </svg>
    </figure>
    {ramps.map(({ group, title, labels }) => <section class="ramp-section" aria-label={title}>
      <h4>{title}</h4>
      <ol class="ramp-grid">
        {labels.map((label, i) => {
          const color = theme.dataviz?.[group][i];
          return <li data-chart-sequential={group === 'sequential' ? i : undefined} data-chart-diverging={group === 'diverging' ? i : undefined} hidden={color === undefined}>
            <span class="ramp-color" aria-hidden="true" style={`background-color:var(--chart-${group}-${i})`}></span>
            <strong>{label}</strong><span data-chart-ramp-value>{color ? `L ${color.oklch.l} · C ${color.oklch.c}` : 'Unavailable'}</span>
            <code data-chart-ramp-css>{color?.oklchCss}</code>
          </li>;
        })}
      </ol>
    </section>)}
    <p class="chart-note" data-chart-ramp-metrics>{model.ramps}</p>
    <details class="sample-table"><summary>Read the identical sample data</summary>
      <table><caption>Illustrative activity hours</caption><thead><tr><th scope="col">Activity</th><th scope="col">Hours</th></tr></thead><tbody>{CHART_ACTIVITIES.map(row => <tr><th scope="row">{row.marker} {row.label}</th><td>{row.value}</td></tr>)}</tbody></table>
      <div class="table-scroll"><table><caption>Illustrative plans by week</caption><thead><tr><th scope="col">Plan</th>{[1, 2, 3, 4, 5, 6].map(week => <th scope="col">W{week}</th>)}</tr></thead><tbody>{CHART_LINES.map(line => <tr><th scope="row">{line.marker} {line.label}</th>{line.values.map(value => <td>{value}</td>)}</tr>)}</tbody></table></div>
    </details>
    <h4>All generated categorical colors</h4>
    <p class="chart-note">The six activity bars use colors 1–6. Additional colors 7–8 remain inspectable and copyable below when the palette supplies them.</p>
    <ul class="viz-chips" role="list">
      {model.palette.map(entry => <li data-chart-swatch={entry.index} hidden={entry.color === undefined}>
        <button type="button" class="viz-chip" data-viz-swatch={entry.index} aria-label={`Copy chart palette color ${entry.index + 1}`}>
          <span class="viz-chip-swatch" aria-hidden="true" data-role="chart-series" data-chart-index={entry.index} data-series-index={entry.index} style={`--viz-color:var(--chart-color-${entry.index})`}>████</span>
          <span>Color {entry.index + 1}</span><code data-value>{entry.color?.oklchCss}</code>
        </button><span class="origin-note" data-chart-origin>{entry.origin}</span>
      </li>)}
    </ul>
  </div>
  <p class="chart-note diagnostic-summary" data-chart-metrics>{model.summary}</p>
</section>
<style>
  .showcase-section { min-width: 0; display: grid; gap: .75rem; border: 1px solid var(--border); border-radius: .75rem; padding: 1rem; background: var(--surface); color: var(--fg); font-size: var(--specimen-size, 14px); line-height: 1.6; }
  header { display: flex; gap: .6rem; justify-content: space-between; flex-wrap: wrap; }
  h3, h4, p, figure { margin: 0; }
  h3, h4 { font-size: 1em; }
  .chart-note, .origin-note { overflow-wrap: anywhere; }
  [data-chart-content] { display: grid; gap: .75rem; min-width: 0; }
  [data-chart-content][hidden], .viz-chips > li[hidden], .ramp-grid > li[hidden] { display: none; }
  .chart-surface { min-width: 0; padding: .75rem; border-radius: .5rem; color: var(--chart-foreground); background: var(--chart-background); }
  figcaption { margin-bottom: .4rem; font-weight: 600; }
  .viz-chart { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .5rem; }
  .viz-chart li { min-width: 0; text-align: center; display: grid; gap: .25rem; }
  .bar-track { height: 6rem; display: flex; align-items: end; justify-content: center; }
  .viz-bar { display: block; width: 80%; background-color: var(--viz-color); border-radius: .15rem .15rem 0 0; }
  .viz-bar[data-selected='true'] { outline: 2px solid var(--chart-foreground); outline-offset: 2px; }
  .bar-label { overflow-wrap: anywhere; }
  .series-controls { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .4rem; }
  .series-controls button, .viz-chip { font: inherit; color: var(--fg); background: var(--surface); border: 1px solid var(--border); border-radius: .4rem; padding: .45rem; cursor: pointer; min-width: 0; }
  .series-controls button[aria-pressed='true'] { box-shadow: inset 0 0 0 2px var(--accent); font-weight: 700; }
  button:focus-visible, summary:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
  .line-chart { display: block; width: 100%; max-height: 10rem; }
  .line-legend { margin: .3rem 0; }
  .ramp-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); list-style: none; gap: .3rem; padding: 0; margin: .4rem 0 0; }
  .ramp-grid li { min-width: 0; display: grid; gap: .2rem; text-align: center; overflow-wrap: anywhere; }
  .ramp-color { display: block; height: 1.75rem; border-radius: .2rem; }
  .ramp-grid code, .viz-chip code { font-size: 1em; overflow-wrap: anywhere; }
  .viz-chips { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; gap: .6rem; }
  .viz-chip { display: grid; width: 100%; text-align: left; gap: .2rem; }
  .viz-chip-swatch { font-family: var(--font-mono); color: var(--viz-color); background-color: var(--chart-background); }
  .origin-note { display: block; }
  .table-scroll { overflow-x: auto; max-width: 100%; }
  table { border-collapse: collapse; margin: .5rem 0; width: 100%; font: inherit; }
  th, td { padding: .25rem; text-align: left; border-bottom: 1px solid var(--border); }
  caption, summary { text-align: left; font-weight: 600; }
  @media(max-width: 30rem) { .showcase-section { padding: .75rem; } .viz-chart { grid-template-columns: repeat(3, minmax(0,1fr)); } .viz-chips { grid-template-columns: minmax(0,1fr); } .ramp-grid { grid-template-columns: repeat(4,minmax(0,1fr)); } }
</style>
