---
// Centralised script for the picker. Wires the ThemeSelector combobox,
// prev/next/random controls, the listbox search + tag filters + sort, the
// showcase colour-variable application (including the dataviz swatch
// panel), and the export menu.
//
// All state is URL-driven: `?theme=<slug>`, `?q=`, `?tags=`, `?sort=`.
---
<script>
  // Behaviour lives in `@/lib/showcase-controller` so it can be driven from
  // jsdom — it was ~630 lines inside this tag and completely untested
  // (issue #178). This tag is now just the production wiring.
  import { initShowcaseController } from '@/lib/showcase-controller';

  initShowcaseController(document, window);
</script>

<style is:global>
  /* Export feedback chip next to the summary. */
  .export-menu summary[data-feedback]::after {
    content: attr(data-feedback);
    display: inline-block;
    margin-left: 0.5rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.7rem;
    background: color-mix(in oklch, var(--accent) 15%, transparent);
    color: var(--accent);
  }
  .export-menu summary[data-feedback-ok='false']::after {
    background: color-mix(in oklch, oklch(0.55 0.18 25) 20%, transparent);
    color: oklch(0.62 0.18 25);
  }
</style>
