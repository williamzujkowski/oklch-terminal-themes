---
import DashboardForms from './DashboardForms.astro';
import { sourceRoleStyle } from '@/lib/specimen-roles';
export interface Props { pane?: string }
const { pane = 'b' } = Astro.props;
const rows = [
  { task: 'Documentation', status: 'Complete', progress: 100, role: 'success' },
  { task: 'Export checklist', status: 'Blocked', progress: 0, role: 'error' },
  { task: 'Keyboard pass', status: 'Needs review', progress: 50, role: 'warning' },
  { task: 'Palette comparison', status: 'Complete', progress: 100, role: 'success' },
] as const;
---
<section class="showcase-section" aria-label="Dashboard sample" data-specimen="dashboard">
  <header><h3>Dashboard</h3><p>Illustrative workspace data and shared local form states.</p></header>
  <div data-scenario="default">
    <p class="demo-note">Static sample data, ordered by task. These values do not describe this repository or any live service.</p>
    <div class="dash" data-preview-surface data-role="body" style={sourceRoleStyle('body')}>
      <h4>Sample workspace</h4>
      <dl class="dash-stats"><div><dt data-role="muted" style={sourceRoleStyle('muted')}>Review items</dt><dd>4</dd></div><div><dt data-role="muted" style={sourceRoleStyle('muted')}>Complete</dt><dd>2</dd></div><div><dt data-role="muted" style={sourceRoleStyle('muted')}>Need attention</dt><dd>2</dd></div></dl>
      <div class="table-scroll">
        <table>
          <caption>Sample review checklist · fixed A–Z order</caption>
          <thead><tr><th scope="col" aria-sort="ascending">Task · A–Z</th><th scope="col">Status</th><th scope="col">Progress</th></tr></thead>
          <tbody>{rows.map((row) => <tr><th scope="row">{row.task}</th><td><span data-role={row.role} style={sourceRoleStyle(row.role)}>{row.status === 'Complete' ? '✓ ' : row.status === 'Blocked' ? '× ' : '! '}{row.status}</span></td><td><progress value={row.progress} max="100" aria-label={`${row.task} sample completion`} style={sourceRoleStyle(row.role)}>{row.progress}%</progress><span>{row.progress}%</span></td></tr>)}</tbody>
        </table>
      </div>
      <p class="dash-note" data-role="comment" style={sourceRoleStyle('comment')}>Text labels and completion values keep each status understandable without its color.</p>
    </div>
  </div>
  <DashboardForms pane={pane} />
</section>
<style>
  .showcase-section { border: 1px solid var(--border); border-radius: .75rem; background: var(--surface); padding: 1rem; display: grid; gap: .75rem; min-width: 0; }
  header { display: flex; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
  h3, header p, .demo-note { margin: 0; font-size: .875rem; line-height: 1.5; }
  .demo-note { margin-bottom: .8rem; }
  .dash { font: var(--specimen-size,14px)/1.6 var(--font-sans); padding: 1em; border-radius: .5rem; min-width: 0; color-scheme: var(--tt-color-scheme,normal); }
  h4 { margin: 0 0 .7em; font-size: 1.2em; }
  .dash-stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: .6em; margin: 0 0 1.1em; }
  .dash-stats > div { padding: .6em; border: 1px solid currentColor; border-radius: .3em; overflow-wrap: anywhere; }
  dt { line-height: 1.4; }
  dd { margin: .25em 0 0; font: 700 1.4em/1.3 var(--font-mono); }
  .table-scroll { min-width: 0; overflow-x: auto; }
  table { border-collapse: collapse; table-layout: fixed; width: 100%; }
  caption { text-align: start; margin-bottom: .5em; }
  th, td { padding: .55em .35em; border-block-end: 1px solid currentColor; text-align: start; overflow-wrap: anywhere; vertical-align: top; }
  th:first-child { width: 40%; }
  thead th:last-child { width: 24%; }
  tbody th { font-weight: 400; }
  progress { display: block; width: 100%; max-width: 100%; height: .8em; margin: .35em 0; accent-color: currentColor; }
  .dash-note { margin: 1em 0 0; }
  @media(max-width: 30rem) { .dash-stats { grid-template-columns: minmax(0,1fr); gap: .4em; } .dash-stats > div { display: flex; justify-content: space-between; gap: .6em; } dd { margin: 0; } }
  .dash ::selection { color: var(--role-selection-fg,var(--tt-foreground)); background: var(--role-selection-bg,var(--tt-selection)); }
</style>
