---
import slim from '@williamzujkowski/oklch-terminal-themes/themes-slim.json';
import ShowcasePalette from './ShowcasePalette.astro';
import ShowcaseTerminal from './ShowcaseTerminal.astro';
import ShowcaseIde from './ShowcaseIde.astro';
import ShowcaseReading from './ShowcaseReading.astro';
import ShowcaseDashboard from './ShowcaseDashboard.astro';
import ShowcaseDataviz from './ShowcaseDataviz.astro';

// Server-render the default theme (issue #217).
//
// The site chrome already avoids a flash via ThemeToggle's pre-paint inline
// script, but the showcase did not: it painted the CSS fallbacks
// (`var(--tt-background, oklch(0.2 0.02 260))`) with an em-dash for the theme
// name, then snapped to the real theme once ~682 KB of inlined JSON had been
// parsed and `applyTheme` ran. The parse cost is what makes that visible
// rather than imperceptible.
//
// Emitting the default theme's custom properties and text into the markup
// means the common case — a visit with no `?theme=` — is correct on first
// paint with no client work at all. A visit that names a different theme
// still repaints once, which is unavoidable without server-side rendering
// per request.
//
// `dracula` matches ShowcaseController's own DEFAULT_THEME fallback order, so
// the two cannot disagree about what "default" means.
const defaultTheme = slim.find((t) => t.slug === 'dracula') ?? slim[0];
// Same camelCase -> kebab transform the client uses in `toCssVar`. Inlined
// rather than imported: the shared `toKebabCase` helper lands with the
// deduplication work in #229, and this file only needs it at build time.
const toCssVarName = (key: string): string =>
  `--tt-${key.replace(/([a-z])([A-Z])/g, '$1-$2').toLowerCase()}`;
const defaultVars = Object.entries(defaultTheme?.colors ?? {})
  .map(([key, value]) => `${toCssVarName(key)}: ${value};`)
  .join(' ');
const defaultMeta =
  defaultTheme === undefined
    ? '—'
    : `${defaultTheme.isDark ? 'dark' : 'light'} · ${defaultTheme.slug}`;
---

<!--
  Screen-reader announcer (issue #210). Changing the theme rewrites the
  heading, the meta line, the WCAG badge and 20 palette values, and none of
  that is announced — a screen-reader user pressing arrow keys to browse got
  total silence.

  `role="status"` is implicitly `aria-live="polite"`, so it waits for a pause
  rather than interrupting. The text is kept terse on purpose: it fires on
  every arrow keypress, and verbosity here becomes noise fast.
-->
<p class="sr-announcer" role="status" data-theme-announcer></p>

<div class="showcase" style={defaultVars}>
  <div class="showcase-head">
    <span class="eyebrow">Preview</span>
    <!-- h2, not h1: the page's single h1 is in `index.astro`, and two h1
         elements is an axe finding (#216). This heading names the previewed
         theme, so the preview sections below it are h3.

         The name is server-rendered (#217/#264) rather than left as a bare
         em-dash: a crawler or no-JS reader would otherwise see a heading
         containing only punctuation, and JS-driven themes would flash. Both
         fixes are needed — the level is the a11y one, the interpolation is
         the FOUC one. -->
    <h2 class="theme-name" data-theme-name>{defaultTheme?.name ?? '—'}</h2>
    <p class="theme-meta">
      <span data-theme-meta>{defaultMeta}</span>
      <!-- WCAG tier comes from theme.contrast.fgOnBg only. Explicitly labeled
           'fg' so users don't assume the rating covers ANSI slots. -->
      <span
        class="wcag-badge"
        data-wcag-badge
        title="Foreground vs background WCAG 2.x contrast. Does not certify ANSI slot legibility."
        hidden
      >
        <span data-wcag-level>—</span>
        <span class="wcag-sep" aria-hidden="true">·</span>
        <span class="wcag-slot">fg</span>
        <span data-wcag-ratio>—</span>
      </span>
    </p>
  </div>
  <div class="showcase-stack">
    <ShowcasePalette />
    <ShowcaseTerminal />
    <ShowcaseIde />
    <ShowcaseReading />
    <ShowcaseDashboard />
    <ShowcaseDataviz />
  </div>
</div>

<style>
  /*
    Off-screen but still announced. Not `display: none` or
    `visibility: hidden` — either would remove it from the accessibility tree
    and silence the very announcements this exists to make.
  */
  .sr-announcer {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .showcase {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }
  .showcase-head {
    padding: 0 0.2rem;
  }
  .showcase-head .eyebrow {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: color-mix(in oklch, var(--fg) 60%, transparent);
  }
  .showcase-head .theme-name {
    margin: 0.1rem 0 0.1rem;
    font-family: var(--font-mono);
    font-size: clamp(1.2rem, 3vw, 1.8rem);
    letter-spacing: -0.01em;
  }
  .showcase-head .theme-meta {
    margin: 0;
    font-size: 0.82rem;
    color: color-mix(in oklch, var(--fg) 60%, transparent);
    display: flex;
    gap: 0.55rem;
    align-items: baseline;
    flex-wrap: wrap;
  }
  .wcag-badge {
    display: inline-flex;
    gap: 0.3rem;
    align-items: baseline;
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    font-family: var(--font-mono);
    background: color-mix(in oklch, var(--accent) 6%, transparent);
    color: var(--fg);
  }
  .wcag-badge[data-wcag-level='AAA'] {
    background: color-mix(in oklch, oklch(0.65 0.16 145) 18%, transparent);
    border-color: oklch(0.65 0.16 145);
  }
  .wcag-badge[data-wcag-level='Fail'] {
    background: color-mix(in oklch, oklch(0.62 0.18 25) 18%, transparent);
    border-color: oklch(0.62 0.18 25);
  }
  .wcag-badge .wcag-sep {
    opacity: 0.5;
  }
  .wcag-badge .wcag-slot {
    color: color-mix(in oklch, var(--fg) 60%, transparent);
  }

  .showcase-stack {
    display: grid;
    gap: 1rem;
  }
</style>
