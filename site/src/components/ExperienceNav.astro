---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const comparison = /\/compare\/?$/.test(Astro.url.pathname);
---
<a data-page-browse href={`${base}/`} aria-current={!comparison ? 'page' : undefined}>Browse</a>
<a data-page-compare href={`${base}/compare/`} aria-current={comparison ? 'page' : undefined}>Compare</a>
<script is:inline define:vars={{ base, comparison }}>
  // Preserve existing shared comparison links after moving that experience.
  if (!comparison && new URLSearchParams(location.search).has('ref')) {
    location.replace(`${base}/compare/${location.search}${location.hash}`);
  }
</script>
<style>
  a { color:var(--fg); text-decoration:none; padding-block:.5rem; font-size:.875rem; }
  a[aria-current=page] { font-weight:700; text-decoration:underline; text-underline-offset:.4rem; text-decoration-color:var(--accent); }
  a:focus-visible { outline:2px solid var(--accent); outline-offset:3px; }
</style>
