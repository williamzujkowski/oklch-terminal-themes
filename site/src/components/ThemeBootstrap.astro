---
import slim from '@williamzujkowski/oklch-terminal-themes/themes-slim.json';
import { bootstrapThemes } from '@/lib/theme-data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Keep escaped JSON and absolute base-prefixed endpoints on both pages.
const payload = JSON.stringify(bootstrapThemes(slim)).replace(/</g, '\\u003c');
---
<script id="themes-data" is:inline type="application/json"
  data-src={`${base}/themes-data.json`} data-details-base={`${base}/theme-data/`}
  set:html={payload} />
