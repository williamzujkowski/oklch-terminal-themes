---
import { ANSI_PAIRS, sourceRoleStyle } from '@/lib/specimen-roles';
import { toKebabCase } from '@/lib/formatters';
---
<section class="showcase-section" aria-label="Terminal session" data-specimen="terminal">
  <header><h3>Terminal</h3><p>Original ANSI slots; font weight and brightness are separate.</p></header>
  <div class="terminal" data-preview-surface style={sourceRoleStyle('body')}>
    <p data-role="comment" style={sourceRoleStyle('comment')}># Review the same workspace and terminal states</p>
    <p><span data-role="success" style={sourceRoleStyle('success')}>user</span>@host <span data-role="link" style={sourceRoleStyle('link')}>~/project</span> $ git diff config.ts</p>
    <p data-role="dim" style={sourceRoleStyle('dim')}>diff --git a/config.ts b/config.ts</p>
    <p data-role="error" style={sourceRoleStyle('error')}>- timeout: 30,</p>
    <p data-role="success" style={sourceRoleStyle('success')}>+ timeout: 60,</p>
    <p data-role="warning" style={sourceRoleStyle('warning')}>! warning: review the retry limit</p>
    <p>selected: <span data-role="selection" style={sourceRoleStyle('selection')}>workspace/config.ts</span></p>
    <p>user@host $ <span class="cursor" data-role="cursor" style={sourceRoleStyle('cursor')}>a</span></p>
    <div class="terminal-states">
      <span data-terminal-state="ordinary">ordinary</span>
      <span data-terminal-state="bold"><strong>bold</strong></span>
      <span data-terminal-state="underline"><u>underline</u></span>
      <span data-terminal-state="inverse" data-role="inverse" style={sourceRoleStyle('inverse')}>inverse</span>
    </div>
  </div>
  <p class="mapping-note">Selected text uses the regular foreground on the selection slot. Cursor text uses the background slot.</p>
  <div class="ansi-pairs" role="table" aria-label="All 16 ANSI text colors">
    <div class="ansi-row" role="row"><span role="columnheader">ANSI pair</span><span role="columnheader">Normal</span><span role="columnheader">Bright</span></div>
    {ANSI_PAIRS.map(([normal, bright]) => (
      <div class="ansi-row" role="row">
        <span role="rowheader">{normal}</span>
        {[normal, bright].map((key) => (
          <span role="cell" class="ansi-sample" data-ansi-slot={key} data-role={`ansi-${key}`} style={`color:var(--tt-${toKebabCase(key)});background-color:var(--tt-background)`}>{key}</span>
        ))}
      </div>
    ))}
  </div>
</section>
<style>
  .showcase-section { border: 1px solid var(--border); border-radius: .75rem; background: var(--surface); padding: 1rem; display: grid; gap: .75rem; min-width: 0; }
  header { display: flex; justify-content: space-between; gap: .7rem; flex-wrap: wrap; }
  h3, header p { margin: 0; font-size: .875rem; }
  .terminal { padding: 1rem; border-radius: .5rem; font: var(--specimen-size, 14px)/1.6 var(--font-mono); overflow-wrap: anywhere; min-width: 0; }
  .terminal p { margin: 0; min-height: 1.6em; }
  .terminal ::selection { color: var(--role-selection-fg,var(--tt-foreground)); background: var(--role-selection-bg,var(--tt-selection)); }
  .cursor { display: inline-block; min-width: .65em; text-align: center; }
  .terminal-states { display: flex; flex-wrap: wrap; gap: 1rem; margin-top: .6rem; }
  .terminal-states strong { font-weight: 700; }
  .mapping-note { margin: 0; color: var(--fg); font-size: .875rem; line-height: 1.5; }
  .ansi-pairs { font: var(--specimen-size, 14px)/1.5 var(--font-mono); min-width: 0; }
  .ansi-row { display: grid; grid-template-columns: minmax(0,.8fr) repeat(2,minmax(0,1fr)); gap: .4rem; align-items: center; margin-bottom: .3rem; }
  .ansi-row [role='rowheader'] { color: var(--fg); }
  .ansi-sample { border-radius: .25rem; padding: .2rem .4rem; overflow-wrap: anywhere; }
  @media(max-width: 30rem) { .showcase-section { padding: .75rem; } .ansi-row { gap: .2rem; } .ansi-sample { padding: .2rem; } }
</style>
