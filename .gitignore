node_modules/
dist/
upstream/
coverage/
*.tsbuildinfo
.DS_Store

# Security discovery log (never committed)
.security-discoveries.jsonl

# nexus-agents trace artefacts (never committed)
runs/

# Link-check cache
.lycheecache

# Astro build artifacts
site/.astro/
site/dist/

# Local-only scratch space. Ad-hoc probes (colour-space experiments, rounding
# checks) belong here so they never show up as untracked noise in `git status`
# — five stray `t*.mjs` files at the repo root are what prompted this (#226).
#
# Deliberately a directory rather than a filename glob: a pattern like
# `t*.mjs` would also swallow real config (`tailwind.config.mjs`,
# `tsup.config.mjs`), which is exactly the kind of quiet, surprising ignore
# rule that is painful to debug later.
scratch/

# nexus-agents local state
.nexus-agents/
