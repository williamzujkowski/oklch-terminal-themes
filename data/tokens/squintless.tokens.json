{
  "$description": "Squintless — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "squintless",
      "name": "Squintless",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Squintless.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.922,
          0.0553,
          92.5
        ],
        "alpha": 1,
        "hex": "#f2e5bc"
      }
    },
    "foreground": {
