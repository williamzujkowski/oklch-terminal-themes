{
  "$description": "EVH FrankenTone — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "evh-frankentone",
      "name": "EVH FrankenTone",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa-large",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/EVH FrankenTone.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5725,
          0.2332,
          29.5
        ],
        "alpha": 1,
        "hex": "#e10600"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8809,
          0.1806,
          94
        ],
        "alpha": 1,
        "hex": "#ffd400"
      }
    },
    "selection": {
