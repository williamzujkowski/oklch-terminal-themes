{
  "$description": "SLOMP — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "slomp",
      "name": "SLOMP",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/04a98db045eb5d71c2247ca6c050ab97290d081c/windowsterminal/SLOMP.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.235,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1e1e1e"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8699,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d4d4d4"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6595,
          0.1373,
          339.5
        ],
        "alpha": 1,
        "hex": "#c86ead"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3091,
          0.0473,
          215.1
        ],
        "alpha": 1,
        "hex": "#0c363f"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.235,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#1e1e1e"
          }
        },
        "red": {
