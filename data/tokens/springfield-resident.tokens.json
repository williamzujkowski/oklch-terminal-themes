{
  "$description": "Springfield Resident — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "springfield-resident",
      "name": "Springfield Resident",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aa",
        "ansi-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
