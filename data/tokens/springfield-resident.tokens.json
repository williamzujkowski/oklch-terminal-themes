    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8999,
          0.1743,
          96.9
        ],
        "alpha": 1,
        "hex": "#ffdd32"
      }
    },
