{
  "$description": "Belafonte Day — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "belafonte-day",
      "name": "Belafonte Day",
      "isDark": false,
      "tags": [
        "light",
