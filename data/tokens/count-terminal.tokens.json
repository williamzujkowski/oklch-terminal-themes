{
  "$description": "Count Terminal — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "count-terminal",
      "name": "Count Terminal",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/d3e95e4f7140c980988781f21534cf51e327af2c/windowsterminal/Count Terminal.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2638,
          0.0932,
          16.8
        ],
        "alpha": 1,
        "hex": "#480814"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9358,
          0.023,
          52.7
        ],
        "alpha": 1,
        "hex": "#f7e6dc"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7515,
          0.1216,
          14.6
        ],
        "alpha": 1,
        "hex": "#f18d96"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7822,
          0.0202,
          1.5
        ],
        "alpha": 1,
        "hex": "#c4b3b7"
      }
    },
