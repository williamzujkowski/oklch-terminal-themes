{
  "$description": "Lumina Espresso Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "lumina-espresso-light",
      "name": "Lumina Espresso Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
