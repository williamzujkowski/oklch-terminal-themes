{
  "$description": "Tomorrow Night Eighties — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "tomorrow-night-eighties",
      "name": "Tomorrow Night Eighties",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution",
        "popular"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Tomorrow Night Eighties.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2972,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#2d2d2d"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8452,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cccccc"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8452,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cccccc"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4349,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#515151"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
