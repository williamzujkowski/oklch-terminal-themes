    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2222,
          0.092,
          279.3
        ],
        "alpha": 1,
        "hex": "#151144"
      }
    },
