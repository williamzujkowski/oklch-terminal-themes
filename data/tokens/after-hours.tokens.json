{
  "$description": "After Hours — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "after-hours",
      "name": "After Hours",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
