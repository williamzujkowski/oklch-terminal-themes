      "counterpart": "vercel"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9878,
          0.0013,
          106.4
        ],
        "alpha": 1,
        "hex": "#fbfbfa"
      }
    },
