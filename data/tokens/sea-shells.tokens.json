{
  "$description": "Sea Shells — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "sea-shells",
      "name": "Sea Shells",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
