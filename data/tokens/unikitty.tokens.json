    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7877,
          0.1651,
          341
        ],
        "alpha": 1,
        "hex": "#ff8cd9"
      }
    },
