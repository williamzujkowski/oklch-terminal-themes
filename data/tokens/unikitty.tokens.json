{
  "$description": "Unikitty — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "unikitty",
      "name": "Unikitty",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "cvd-caution"
