{
  "$description": "Ember Peak — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "ember-peak",
      "name": "Ember Peak",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/450b05ea0962456b424e5736aed0bec7fd147f28/windowsterminal/Ember Peak.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1473,
          0.0107,
          285
        ],
        "alpha": 1,
        "hex": "#0a0a0f"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9842,
          0.0034,
          247.9
        ],
        "alpha": 1,
        "hex": "#f8fafc"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8338,
          0.1249,
          66.9
        ],
        "alpha": 1,
        "hex": "#ffb86b"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.251,
          0.0247,
          58.2
        ],
        "alpha": 1,
        "hex": "#2b1f16"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7738,
              0.0048,
              78.3
            ],
            "alpha": 1,
            "hex": "#b7b5b2"
          }
        },
        "red": {
