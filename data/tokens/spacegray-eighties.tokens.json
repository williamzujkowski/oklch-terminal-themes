{
  "$description": "Spacegray Eighties — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "spacegray-eighties",
      "name": "Spacegray Eighties",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Spacegray Eighties.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.252,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#222222"
      }
    },
    "foreground": {
