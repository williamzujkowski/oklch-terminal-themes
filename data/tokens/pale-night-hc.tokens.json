{
  "$description": "Pale Night Hc — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "pale-night-hc",
      "name": "Pale Night Hc",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
