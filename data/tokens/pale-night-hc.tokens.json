    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3814,
          0.0261,
          273.4
        ],
        "alpha": 1,
        "hex": "#3e4251"
      }
    },
