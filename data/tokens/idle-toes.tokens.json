{
  "$description": "Idle Toes — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "idle-toes",
      "name": "Idle Toes",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Idle Toes.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3171,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#323232"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8761,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d6d6d6"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4712,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#5b5b5b"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3171,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#323232"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6076,
              0.1624,
              23.2
            ],
            "alpha": 1,
            "hex": "#d25252"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8245,
              0.174,
              141.6
            ],
            "alpha": 1,
            "hex": "#7fe173"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8601,
              0.1248,
              77
            ],
            "alpha": 1,
            "hex": "#ffc66d"
          }
        },
        "blue": {
