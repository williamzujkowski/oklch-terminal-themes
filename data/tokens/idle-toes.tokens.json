            ],
            "alpha": 1,
            "hex": "#bed6ff"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9486,
              0.0027,
              106.5
            ],
            "alpha": 1,
            "hex": "#eeeeec"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
