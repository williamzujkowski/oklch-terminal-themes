{
  "$description": "X Oslo — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "x-oslo",
      "name": "X Oslo",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/450b05ea0962456b424e5736aed0bec7fd147f28/windowsterminal/X Oslo.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3871,
          0.0231,
          268.7
        ],
        "alpha": 1,
        "hex": "#3f4451"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7621,
          0.0202,
          263
        ],
        "alpha": 1,
        "hex": "#abb2bf"
