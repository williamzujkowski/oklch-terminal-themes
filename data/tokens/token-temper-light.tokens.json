{
  "$description": "token-temper-light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "token-temper-light",
      "name": "token-temper-light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "thorsten-token",
