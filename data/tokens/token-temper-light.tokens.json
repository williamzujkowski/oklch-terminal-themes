      "counterpart": "token-temper-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9749,
          0.0025,
          228.8
        ],
        "alpha": 1,
        "hex": "#f5f7f8"
      }
    },
