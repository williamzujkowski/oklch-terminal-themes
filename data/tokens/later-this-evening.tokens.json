{
  "$description": "Later This Evening — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "later-this-evening",
      "name": "Later This Evening",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Later This Evening.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.252,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#222222"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6698,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#959595"
      }
    },
    "cursor": {
