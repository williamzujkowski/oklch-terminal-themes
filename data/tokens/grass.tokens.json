{
  "$description": "Grass — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "grass",
      "name": "Grass",
      "isDark": false,
      "tags": [
        "light",
        "low-contrast",
        "wcag-aa",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Grass.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5013,
          0.1254,
          151.7
        ],
        "alpha": 1,
        "hex": "#13773d"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9502,
          0.0953,
          98.2
        ],
        "alpha": 1,
        "hex": "#fff0a5"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.666,
          0.1377,
          41.7
        ],
        "alpha": 1,
        "hex": "#d9744c"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5456,
          0.1498,
          37.8
        ],
        "alpha": 1,
        "hex": "#b64926"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
