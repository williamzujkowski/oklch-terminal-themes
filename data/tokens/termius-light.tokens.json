      "counterpart": "termius-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8923,
          0.0096,
          222.1
        ],
        "alpha": 1,
        "hex": "#d5dde0"
      }
    },
    "foreground": {
