{
  "$description": "Tailwind Slate Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "tailwind-slate-dark",
      "name": "Tailwind Slate Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "native",
      "sourceUrl": "https://github.com/williamzujkowski/oklch-terminal-themes/blob/main/data-sources/native/tailwind-slate-dark.json",
      "counterpart": "tailwind-slate-light"
    }
  },
  "color": {
