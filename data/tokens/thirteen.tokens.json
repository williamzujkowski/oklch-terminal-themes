    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.184,
          0.0548,
          22.2
        ],
        "alpha": 1,
        "hex": "#260607"
      }
    },
