{
  "$description": "Treehouse — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "treehouse",
      "name": "Treehouse",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa-large",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Treehouse.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2134,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#191919"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5334,
          0.0392,
          82.7
        ],
        "alpha": 1,
        "hex": "#786b53"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8527,
          0.1715,
          90
        ],
        "alpha": 1,
        "hex": "#fac814"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5334,
          0.0392,
          82.7
        ],
        "alpha": 1,
        "hex": "#786b53"
      }
    },
