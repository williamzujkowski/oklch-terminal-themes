{
  "$description": "Sequoia Retro Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "sequoia-retro-light",
      "name": "Sequoia Retro Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Sequoia Retro Light.json",
      "counterpart": "sequoia-retro-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9495,
          0.0055,
          275
        ],
        "alpha": 1,
        "hex": "#edeef2"
      }
    },
    "foreground": {
