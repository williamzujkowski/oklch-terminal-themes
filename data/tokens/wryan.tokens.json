{
  "$description": "Wryan — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "wryan",
      "name": "Wryan",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Wryan.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.173,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#101010"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6812,
          0.0086,
          106.6
        ],
        "alpha": 1,
        "hex": "#999993"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7152,
          0.0652,
          284.6
        ],
        "alpha": 1,
        "hex": "#9e9ecb"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4202,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4d4d4d"
      }
    },
