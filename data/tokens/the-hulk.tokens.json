{
  "$description": "The Hulk — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "the-hulk",
      "name": "The Hulk",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
