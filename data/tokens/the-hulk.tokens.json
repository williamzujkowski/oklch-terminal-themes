    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.229,
          0.0036,
          229
        ],
        "alpha": 1,
        "hex": "#1b1d1e"
      }
    },
    "foreground": {
