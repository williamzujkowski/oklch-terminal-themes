{
  "$description": "Rainbows and Unicorns Workbench — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "rainbows-and-unicorns-workbench",
      "name": "Rainbows and Unicorns Workbench",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/5fad1bde2d00c4eb9cb9264599ebb3d981eca4f0/windowsterminal/Rainbows and Unicorns Workbench.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3887,
          0.1433,
          257.9
        ],
        "alpha": 1,
        "hex": "#00408f"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7442,
          0.1812,
          56.5
        ],
        "alpha": 1,
        "hex": "#ff8800"
      }
    },
    "selection": {
