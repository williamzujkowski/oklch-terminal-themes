{
  "$description": "Django — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "django",
      "name": "Django",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Django.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2745,
          0.0498,
          162.3
        ],
        "alpha": 1,
        "hex": "#0b2f20"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9791,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f8f8f8"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4586,
          0.0773,
          152.2
        ],
        "alpha": 1,
        "hex": "#336442"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3908,
          0.0708,
          152.2
        ],
        "alpha": 1,
        "hex": "#245032"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6879,
              0.2048,
              42.1
            ],
            "alpha": 1,
            "hex": "#fd6209"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6486,
              0.1732,
              142.8
            ],
            "alpha": 1,
            "hex": "#41a83e"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9252,
              0.1534,
              99.6
            ],
            "alpha": 1,
            "hex": "#ffe862"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4375,
              0.07,
              152.8
            ],
            "alpha": 1,
            "hex": "#315d3f"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9791,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#f8f8f8"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8888,
              0.1411,
              144.8
            ],
            "alpha": 1,
            "hex": "#9df39f"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4604,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#585858"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7659,
              0.162,
