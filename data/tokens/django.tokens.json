            "alpha": 1,
            "hex": "#73da70"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9776,
              0.1297,
              108.6
            ],
            "alpha": 1,
            "hex": "#ffff94"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5657,
