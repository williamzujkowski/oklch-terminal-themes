{
  "$description": "Apple Classic — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "apple-classic",
      "name": "Apple Classic",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Apple Classic.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2901,
          0.0014,
          17.2
        ],
        "alpha": 1,
        "hex": "#2c2b2b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7395,
          0.1514,
          85.8
        ],
        "alpha": 1,
        "hex": "#d5a200"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8297,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#c7c7c7"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4728,
          0.0967,
          97.1
        ],
        "alpha": 1,
        "hex": "#6b5b02"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
