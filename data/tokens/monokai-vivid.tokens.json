{
  "$description": "Monokai Vivid — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "monokai-vivid",
      "name": "Monokai Vivid",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution",
        "popular"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Monokai Vivid.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1822,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#121212"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9821,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f9f9f9"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6207,
          0.2544,
          28.8
        ],
        "alpha": 1,
        "hex": "#fb0007"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1822,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#121212"
          }
        },
        "red": {
