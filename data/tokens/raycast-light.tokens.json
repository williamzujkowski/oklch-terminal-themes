{
  "$description": "Raycast Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "raycast-light",
      "name": "Raycast Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Raycast Light.json",
      "counterpart": "raycast-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9219,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e5e5e5"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4966,
              0.1771,
              26.6
            ],
            "alpha": 1,
            "hex": "#b12424"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4684,
              0.0958,
              167.2
            ],
            "alpha": 1,
            "hex": "#006b4f"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7809,
              0.1671,
              72.1
            ],
            "alpha": 1,
            "hex": "#f8a300"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6291,
              0.1822,
              252
            ],
            "alpha": 1,
            "hex": "#138af2"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4682,
              0.1782,
              346.5
            ],
            "alpha": 1,
            "hex": "#9a1b6e"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7193,
              0.1055,
              200.6
            ],
            "alpha": 1,
            "hex": "#3eb8bf"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8047,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bfbfbf"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4966,
              0.1771,
              26.6
            ],
            "alpha": 1,
            "hex": "#b12424"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4684,
              0.0958,
              167.2
            ],
            "alpha": 1,
            "hex": "#006b4f"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7809,
              0.1671,
              72.1
            ],
            "alpha": 1,
            "hex": "#f8a300"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6291,
              0.1822,
              252
            ],
            "alpha": 1,
            "hex": "#138af2"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4682,
              0.1782,
              346.5
            ],
            "alpha": 1,
            "hex": "#9a1b6e"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7193,
              0.1055,
              200.6
            ],
            "alpha": 1,
            "hex": "#3eb8bf"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    }
  }
}
