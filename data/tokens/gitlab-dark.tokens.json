            ],
            "alpha": 1,
            "hex": "#5edee3"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    }
  }
}
