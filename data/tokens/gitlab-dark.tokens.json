{
  "$description": "GitLab Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "gitlab-dark",
      "name": "GitLab Dark",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/GitLab Dark.json",
      "counterpart": "gitlab-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2728,
          0.0095,
          303.8
        ],
        "alpha": 1,
        "hex": "#28262b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7235,
          0.1217,
          296.4
        ],
        "alpha": 1,
        "hex": "#ad95e9"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7257,
              0.1483,
              30.5
            ],
            "alpha": 1,
            "hex": "#f57f6c"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7058,
              0.1324,
              154.3
            ],
            "alpha": 1,
            "hex": "#52b87a"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7207,
              0.1374,
              72.2
            ],
            "alpha": 1,
            "hex": "#d99530"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7592,
              0.0984,
              249.2
            ],
            "alpha": 1,
            "hex": "#7fb6ed"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7622,
              0.1389,
              359.4
            ],
            "alpha": 1,
            "hex": "#f88aaf"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7552,
              0.1186,
              204
            ],
            "alpha": 1,
            "hex": "#32c5d2"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5103,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#666666"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8367,
              0.0848,
