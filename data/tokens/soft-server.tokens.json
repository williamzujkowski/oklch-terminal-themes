{
  "$description": "Soft Server — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "soft-server",
      "name": "Soft Server",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Soft Server.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2666,
          0.0029,
          197
        ],
        "alpha": 1,
        "hex": "#242626"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7072,
          0.0115,
          189.7
        ],
        "alpha": 1,
        "hex": "#99a3a2"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8956,
          0.0153,
          186.7
        ],
        "alpha": 1,
        "hex": "#d2e0de"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6165,
          0.0095,
          188
        ],
        "alpha": 1,
        "hex": "#7f8786"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
