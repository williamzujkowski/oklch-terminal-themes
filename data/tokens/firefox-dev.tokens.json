{
  "$description": "Firefox Dev — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "firefox-dev",
      "name": "Firefox Dev",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Firefox Dev.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1712,
          0.0039,
          229.1
        ],
        "alpha": 1,
        "hex": "#0e1011"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6423,
          0.0384,
          251
        ],
        "alpha": 1,
        "hex": "#7c8fa4"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5928,
          0.0212,
          204.8
        ],
        "alpha": 1,
        "hex": "#708284"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3491,
          0.0777,
          250.6
        ],
        "alpha": 1,
        "hex": "#163c61"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2552,
              0.0455,
              216.8
            ],
            "alpha": 1,
            "hex": "#002831"
          }
        },
