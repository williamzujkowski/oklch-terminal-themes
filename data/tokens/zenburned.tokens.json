{
  "$description": "Zenburned — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "zenburned",
      "name": "Zenburned",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
