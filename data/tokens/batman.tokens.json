{
  "$description": "Batman — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "batman",
      "name": "Batman",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "low-contrast",
        "wcag-aa-large",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Batman.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.229,
          0.0036,
          229
        ],
        "alpha": 1,
        "hex": "#1b1d1e"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5417,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#6f6f6f"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9326,
          0.1972,
          105.6
        ],
        "alpha": 1,
        "hex": "#fcef0c"
      }
    },
    "selection": {
