{
  "$description": "Rippedcasts — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "rippedcasts",
      "name": "Rippedcasts",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Rippedcasts.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2891,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#2b2b2b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5965,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#7f7f7f"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5047,
          0.0433,
          268.4
        ],
        "alpha": 1,
        "hex": "#5a647e"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7735,
              0.05,
              62.9
            ],
            "alpha": 1,
            "hex": "#cdaf95"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9136,
              0.2086,
              133.4
            ],
            "alpha": 1,
            "hex": "#a8ff60"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7709,
              0.1594,
              108
            ],
            "alpha": 1,
            "hex": "#bfbb1f"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6916,
              0.0536,
              213.5
            ],
            "alpha": 1,
            "hex": "#75a5b0"
          }
        },
        "purple": {
