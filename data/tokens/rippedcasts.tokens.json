            ],
            "alpha": 1,
            "hex": "#ff73fd"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5047,
              0.0433,
              268.4
            ],
            "alpha": 1,
            "hex": "#5a647e"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8047,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bfbfbf"
          }
        }
      },
      "bright": {
