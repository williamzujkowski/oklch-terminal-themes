    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2617,
          0.0148,
          226.7
        ],
        "alpha": 1,
        "hex": "#1d262a"
      }
    },
