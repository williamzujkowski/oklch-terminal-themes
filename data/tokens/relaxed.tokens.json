    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3477,
          0.0188,
          264.3
        ],
        "alpha": 1,
        "hex": "#353a44"
      }
    },
