{
  "$description": "Relaxed — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "relaxed",
      "name": "Relaxed",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
