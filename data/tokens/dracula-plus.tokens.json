    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2478,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#212121"
      }
    },
    "foreground": {
