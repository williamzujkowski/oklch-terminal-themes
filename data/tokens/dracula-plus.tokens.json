{
  "$description": "Dracula+ — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "dracula-plus",
      "name": "Dracula+",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution",
        "popular"
      ],
      "source": "iterm2-color-schemes",
