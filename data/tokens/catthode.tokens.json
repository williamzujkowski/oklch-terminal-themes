{
  "$description": "Catthode — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "catthode",
      "name": "Catthode",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/Catthode.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7827,
          0.1579,
          61.7
        ],
        "alpha": 1,
        "hex": "#ff9e3b"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2972,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#2d2d2d"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1913,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#141414"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7116,
              0.1812,
              22.8
            ],
            "alpha": 1,
            "hex": "#ff6b6b"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8312,
              0.1436,
              121.5
            ],
            "alpha": 1,
            "hex": "#b9d665"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8339,
              0.1241,
              66.6
            ],
            "alpha": 1,
            "hex": "#ffb86c"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8483,
              0.0644,
              212.3
            ],
            "alpha": 1,
            "hex": "#9cd9e6"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7942,
              0.0898,
              355.7
            ],
            "alpha": 1,
            "hex": "#eba4be"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.882,
              0.0613,
              175.4
            ],
            "alpha": 1,
            "hex": "#aee6d6"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7668,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#b3b3b3"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4997,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#636363"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7116,
              0.1812,
              22.8
            ],
            "alpha": 1,
            "hex": "#ff6b6b"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8312,
              0.1436,
              121.5
            ],
            "alpha": 1,
            "hex": "#b9d665"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9256,
              0.0434,
              69.5
            ],
            "alpha": 1,
            "hex": "#fae2c8"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8483,
              0.0644,
              212.3
            ],
            "alpha": 1,
            "hex": "#9cd9e6"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7942,
              0.0898,
              355.7
            ],
            "alpha": 1,
            "hex": "#eba4be"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.882,
              0.0613,
              175.4
            ],
            "alpha": 1,
            "hex": "#aee6d6"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    }
  }
}
