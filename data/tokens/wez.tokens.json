            "colorSpace": "oklch",
            "components": [
              0.6451,
              0.2053,
              327.6
            ],
            "alpha": 1,
            "hex": "#cc55cc"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7879,
              0.0787,
              195.7
            ],
            "alpha": 1,
            "hex": "#7acaca"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8452,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#cccccc"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4495,
              0,
              "none"
            ],
            "alpha": 1,
