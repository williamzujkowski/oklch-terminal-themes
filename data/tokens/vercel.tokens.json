            "colorSpace": "oklch",
            "components": [
              0.6987,
              0.1782,
              309.5
            ],
            "alpha": 1,
            "hex": "#bf7af0"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.74,
              0.1305,
              183.3
            ],
            "alpha": 1,
            "hex": "#0ac5b3"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7058,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#a0a0a0"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
