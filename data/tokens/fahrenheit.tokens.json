          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6764,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#979797"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9879,
              0.0629,
              107.5
            ],
            "alpha": 1,
            "hex": "#ffffce"
          }
        }
      },
      "bright": {
