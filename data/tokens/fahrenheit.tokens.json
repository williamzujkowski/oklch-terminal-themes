{
  "$description": "Fahrenheit — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "fahrenheit",
      "name": "Fahrenheit",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Fahrenheit.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9879,
          0.0629,
          107.5
        ],
        "alpha": 1,
        "hex": "#ffffce"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7921,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bbbbbb"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5466,
          0.0811,
          253.4
        ],
        "alpha": 1,
        "hex": "#4e739f"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2308,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#1d1d1d"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7371,
              0.0796,
              65.4
            ],
            "alpha": 1,
            "hex": "#cda074"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.592,
              0.0757,
              63.4
            ],
            "alpha": 1,
            "hex": "#9e744d"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8773,
              0.1207,
              82.3
            ],
            "alpha": 1,
            "hex": "#fecf75"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3826,
