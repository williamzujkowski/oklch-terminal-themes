            ],
            "alpha": 1,
            "hex": "#b449be"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8039,
              0.1192,
              232.7
            ],
            "alpha": 1,
            "hex": "#66ccff"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7921,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bbbbbb"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5103,
