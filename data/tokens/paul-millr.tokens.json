{
  "$description": "Paul Millr — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "paul-millr",
      "name": "Paul Millr",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Paul Millr.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9612,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f2f2f2"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4202,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4d4d4d"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3753,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#414141"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.285,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#2a2a2a"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.628,
              0.2577,
              29.2
            ],
            "alpha": 1,
            "hex": "#ff0000"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8882,
              0.2658,
              136.8
            ],
            "alpha": 1,
            "hex": "#79ff0f"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8157,
              0.1671,
              93.6
            ],
            "alpha": 1,
            "hex": "#e7bf00"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5532,
              0.1748,
              263.2
            ],
            "alpha": 1,
            "hex": "#396bd7"
          }
        },
        "purple": {
