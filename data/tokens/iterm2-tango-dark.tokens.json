{
  "$description": "iTerm2 Tango Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "iterm2-tango-dark",
      "name": "iTerm2 Tango Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution",
        "popular"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/iTerm2 Tango Dark.json",
      "counterpart": "iterm2-tango-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8901,
          0.0551,
          251.8
        ],
        "alpha": 1,
        "hex": "#c1deff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
