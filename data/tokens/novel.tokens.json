{
  "$description": "Novel — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "novel",
      "name": "Novel",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Novel.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8882,
          0.0324,
          99.3
        ],
        "alpha": 1,
        "hex": "#dfdbc3"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2865,
          0.0371,
          22.2
        ],
        "alpha": 1,
        "hex": "#3b2322"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5124,
          0.0249,
          51.2
        ],
        "alpha": 1,
        "hex": "#73635a"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.711,
          0.0269,
          104.6
        ],
        "alpha": 1,
        "hex": "#a4a390"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5308,
              0.2178,
              29.2
            ],
            "alpha": 1,
            "hex": "#cc0000"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5832,
              0.1985,
              142.5
            ],
            "alpha": 1,
            "hex": "#009600"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6337,
              0.157,
              55
            ],
            "alpha": 1,
            "hex": "#d06b00"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3821,
              0.2647,
              264.1
            ],
            "alpha": 1,
            "hex": "#0000cc"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5931,
              0.2726,
              328.4
            ],
            "alpha": 1,
            "hex": "#cc00cc"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5975,
              0.1421,
              242.1
            ],
            "alpha": 1,
            "hex": "#0087cc"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7252,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#a6a6a6"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5999,
              0,
              "none"
            ],
            "alpha": 1,
