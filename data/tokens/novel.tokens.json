          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6337,
              0.157,
              55
            ],
            "alpha": 1,
            "hex": "#d06b00"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3821,
              0.2647,
              264.1
            ],
            "alpha": 1,
            "hex": "#0000cc"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
