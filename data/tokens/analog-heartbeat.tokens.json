{
  "$description": "Analog Heartbeat — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "analog-heartbeat",
      "name": "Analog Heartbeat",
      "isDark": true,
      "tags": [
        "dark",
