      "counterpart": "atom-one-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.263,
          0.0127,
          258.4
        ],
        "alpha": 1,
        "hex": "#21252b"
      }
    },
