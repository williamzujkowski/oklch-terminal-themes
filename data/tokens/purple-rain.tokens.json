    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2283,
          0.1102,
          292.4
        ],
        "alpha": 1,
        "hex": "#21084a"
      }
    },
