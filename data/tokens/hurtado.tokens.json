              330.9
            ],
            "alpha": 1,
            "hex": "#fd5ff1"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8808,
              0.0974,
              212.9
            ],
            "alpha": 1,
            "hex": "#86e9fe"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8441,
              0.0017,
              145.6
            ],
            "alpha": 1,
            "hex": "#cbcccb"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3715,
              0,
