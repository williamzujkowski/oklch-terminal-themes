    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9843,
          0.0135,
          78.3
        ],
        "alpha": 1,
        "hex": "#fff9f0"
      }
    },
