{
  "$description": "Framer — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "framer",
      "name": "Framer",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa-large",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Framer.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1776,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5693,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#777777"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.894,
          0.1841,
          98.5
        ],
        "alpha": 1,
        "hex": "#fcdc08"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5103,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#666666"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1913,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#141414"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6822,
              0.2063,
              24.4
            ],
            "alpha": 1,
            "hex": "#ff5555"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8612,
              0.1883,
              135.3
            ],
            "alpha": 1,
            "hex": "#98ec65"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8666,
              0.1647,
              88.7
            ],
            "alpha": 1,
            "hex": "#ffcc33"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7072,
              0.1679,
              242
            ],
            "alpha": 1,
            "hex": "#00aaff"
