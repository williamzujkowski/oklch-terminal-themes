        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8557,
              0.095,
              225.6
            ],
            "alpha": 1,
            "hex": "#88ddff"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8452,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#cccccc"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3753,
