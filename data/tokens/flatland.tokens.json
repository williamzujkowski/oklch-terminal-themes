{
  "$description": "Flatland — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "flatland",
      "name": "Flatland",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Flatland.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.238,
          0.0049,
          248
        ],
        "alpha": 1,
        "hex": "#1d1f21"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8725,
          0.0462,
          233.1
        ],
        "alpha": 1,
        "hex": "#b8dbef"
      }
    },
