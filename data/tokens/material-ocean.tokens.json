{
  "$description": "Material Ocean — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "material-ocean",
      "name": "Material Ocean",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution",
        "popular"
