        "colorSpace": "oklch",
        "components": [
          0.9772,
          0.0606,
          106.5
        ],
        "alpha": 1,
        "hex": "#fcfbcc"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4202,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4d4d4d"
      }
    },
