{
  "$description": "Square — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "square",
      "name": "Square",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Square.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2178,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7441,
          0.0014,
          106.4
        ],
        "alpha": 1,
        "hex": "#acacab"
      }
    },
    "cursor": {
