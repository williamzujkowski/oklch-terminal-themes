        "colorSpace": "oklch",
        "components": [
          0.7469,
          0.1495,
          233.7
        ],
        "alpha": 1,
        "hex": "#20bbfc"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8658,
          0.0643,
          253.6
        ],
        "alpha": 1,
        "hex": "#b6d6fd"
      }
    },
