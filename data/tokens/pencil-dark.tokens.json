{
  "$description": "Pencil Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "pencil-dark",
      "name": "Pencil Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Pencil Dark.json",
      "counterpart": "pencil-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2478,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#212121"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9581,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f1f1f1"
      }
    },
    "cursor": {
