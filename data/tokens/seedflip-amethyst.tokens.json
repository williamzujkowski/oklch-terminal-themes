{
  "$description": "SeedFlip Amethyst — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "seedflip-amethyst",
      "name": "SeedFlip Amethyst",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/SeedFlip Amethyst.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9766,
          0.0017,
          67.8
        ],
        "alpha": 1,
        "hex": "#f8f7f6"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1929,
          0.0691,
          300.4
        ],
        "alpha": 1,
        "hex": "#1a0a2e"
