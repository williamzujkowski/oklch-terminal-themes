      "counterpart": "analyzed-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1831,
          0.0309,
          263.4
        ],
        "alpha": 1,
        "hex": "#0b1220"
      }
    },
