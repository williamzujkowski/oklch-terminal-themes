{
  "$description": "Builtin Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "builtin-dark",
      "name": "Builtin Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Builtin Dark.json",
      "counterpart": "builtin-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7921,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bbbbbb"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7921,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bbbbbb"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8639,
          0.068,
          255.3
        ],
        "alpha": 1,
        "hex": "#b5d5ff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
