    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9697,
          0.0148,
          251.2
        ],
        "alpha": 1,
        "hex": "#eef6ff"
      }
