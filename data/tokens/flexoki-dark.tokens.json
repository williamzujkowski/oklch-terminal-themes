      "counterpart": "flexoki-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1696,
          0.0017,
          17.3
        ],
        "alpha": 1,
        "hex": "#100f0f"
      }
    },
