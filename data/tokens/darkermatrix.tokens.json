{
  "$description": "Darkermatrix — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "darkermatrix",
      "name": "Darkermatrix",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "cvd-caution"
