    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3012,
          0.1164,
          314.9
        ],
        "alpha": 1,
        "hex": "#431455"
      }
    },
