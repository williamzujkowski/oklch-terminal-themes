            "colorSpace": "oklch",
            "components": [
              0.6076,
              0.1624,
              23.2
            ],
            "alpha": 1,
            "hex": "#d25252"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7713,
              0.1285,
              123.2
            ],
            "alpha": 1,
            "hex": "#a5c261"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8601,
