            "colorSpace": "oklch",
            "components": [
              0.8171,
              0.1876,
              116.5
            ],
            "alpha": 1,
            "hex": "#bdd100"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8638,
              0.1306,
              89.6
            ],
            "alpha": 1,
            "hex": "#f4ce65"
