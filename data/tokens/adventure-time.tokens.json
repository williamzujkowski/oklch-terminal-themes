    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2575,
          0.0728,
          282.2
        ],
        "alpha": 1,
        "hex": "#1f1d45"
      }
    },
