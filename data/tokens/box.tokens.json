{
  "$description": "Box — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "box",
      "name": "Box",
      "isDark": true,
      "tags": [
        "dark",
        "vibrant",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Box.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2292,
          0.0304,
          259
        ],
        "alpha": 1,
        "hex": "#141d2b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8668,
          0.2328,
          129.9
        ],
        "alpha": 1,
        "hex": "#9fef00"
      }
    },
    "cursor": {
