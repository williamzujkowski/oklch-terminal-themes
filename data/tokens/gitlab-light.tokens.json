{
  "$description": "GitLab Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "gitlab-light",
      "name": "GitLab Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/GitLab Light.json",
      "counterpart": "gitlab-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9865,
          0.0066,
          286.3
        ],
        "alpha": 1,
        "hex": "#fafaff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3092,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#303030"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3092,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#303030"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7235,
          0.1217,
          296.4
        ],
        "alpha": 1,
        "hex": "#ad95e9"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3092,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#303030"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4587,
              0.1757,
              31.6
            ],
            "alpha": 1,
            "hex": "#a31700"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.523,
              0.1379,
              150.9
            ],
            "alpha": 1,
            "hex": "#0a7f3d"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5519,
              0.1347,
              48.1
            ],
            "alpha": 1,
            "hex": "#af551d"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.544,
              0.1853,
              255.9
            ],
            "alpha": 1,
            "hex": "#006cd8"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4532,
              0.1699,
              289.3
            ],
            "alpha": 1,
            "hex": "#583cac"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5286,
              0.092,
              211.7
            ],
            "alpha": 1,
            "hex": "#00798a"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3092,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#303030"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
