{
  "$description": "Zacess High Contrast Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "zacess-high-contrast-light",
      "name": "Zacess High Contrast Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/04a98db045eb5d71c2247ca6c050ab97290d081c/windowsterminal/Zacess High Contrast Light.json",
      "counterpart": "zacess-high-contrast-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9513,
          0.1019,
          99.6
        ],
        "alpha": 1,
        "hex": "#fff1a0"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
