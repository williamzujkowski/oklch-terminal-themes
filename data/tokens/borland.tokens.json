{
  "$description": "Borland — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "borland",
      "name": "Borland",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Borland.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3249,
          0.2251,
          264.1
        ],
        "alpha": 1,
        "hex": "#0000a4"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9705,
          0.1875,
          109.4
        ],
        "alpha": 1,
        "hex": "#ffff4e"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7985,
          0.1363,
          56.7
        ],
        "alpha": 1,
        "hex": "#ffa560"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7187,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#a4a4a4"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
