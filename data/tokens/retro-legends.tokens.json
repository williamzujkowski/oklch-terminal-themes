{
  "$description": "Retro Legends — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "retro-legends",
      "name": "Retro Legends",
      "isDark": true,
      "tags": [
        "dark",
        "vibrant",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Retro Legends.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1591,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0d0d0d"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8249,
          0.2451,
          142.9
        ],
        "alpha": 1,
        "hex": "#45eb45"
