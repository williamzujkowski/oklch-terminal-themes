            ],
            "alpha": 1,
            "hex": "#20c5c6"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8297,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#c7c7c7"
