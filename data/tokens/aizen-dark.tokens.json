{
  "$description": "Aizen Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "aizen-dark",
      "name": "Aizen Dark",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Aizen Dark.json",
      "counterpart": "aizen-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2178,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8795,
          0.0364,
          275.3
        ],
        "alpha": 1,
        "hex": "#d0d6f0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8149,
          0.1054,
          54.4
        ],
        "alpha": 1,
        "hex": "#f8b080"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3211,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#333333"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2178,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#1a1a1a"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7428,
              0.1274,
              10.8
            ],
            "alpha": 1,
            "hex": "#f08898"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8487,
              0.111,
              141.6
            ],
            "alpha": 1,
            "hex": "#a4e09c"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9058,
              0.0785,
              88.9
            ],
            "alpha": 1,
            "hex": "#f5dea4"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7626,
              0.111,
              257.1
            ],
            "alpha": 1,
            "hex": "#84b4f8"
          }
        },
        "purple": {
