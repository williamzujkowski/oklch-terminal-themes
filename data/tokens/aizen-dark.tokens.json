            "colorSpace": "oklch",
            "components": [
              0.8415,
              0.0773,
              183.4
            ],
            "alpha": 1,
            "hex": "#90dcd0"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8795,
              0.0364,
              275.3
            ],
            "alpha": 1,
            "hex": "#d0d6f0"
          }
        }
