            "components": [
              0.7848,
              0.14,
              159.7
            ],
            "alpha": 1,
            "hex": "#59d499"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.853,
              0.1628,
              85.2
            ],
            "alpha": 1,
            "hex": "#ffc531"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7761,
              0.1315,
              236.8
            ],
            "alpha": 1,
            "hex": "#56c2ff"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5889,
              0.2172,
              345.8
            ],
            "alpha": 1,
            "hex": "#cf2f98"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8663,
              0.1293,
              189.5
            ],
            "alpha": 1,
            "hex": "#52eee5"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      }
    }
  }
}
