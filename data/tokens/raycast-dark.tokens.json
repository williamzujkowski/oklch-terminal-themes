{
  "$description": "Raycast Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "raycast-dark",
      "name": "Raycast Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Raycast Dark.json",
      "counterpart": "raycast-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2178,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8452,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cccccc"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3211,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#333333"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6819,
              0.2073,
              20.4
            ],
            "alpha": 1,
            "hex": "#ff5360"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7848,
              0.14,
              159.7
            ],
            "alpha": 1,
            "hex": "#59d499"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.853,
              0.1628,
              85.2
            ],
            "alpha": 1,
            "hex": "#ffc531"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7761,
              0.1315,
              236.8
            ],
            "alpha": 1,
            "hex": "#56c2ff"
          }
        },
        "purple": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5889,
              0.2172,
              345.8
            ],
            "alpha": 1,
            "hex": "#cf2f98"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8663,
              0.1293,
              189.5
            ],
            "alpha": 1,
            "hex": "#52eee5"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4165,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#4c4c4c"
          }
        },
        "red": {
          "$value": {
