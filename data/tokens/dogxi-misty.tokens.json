{
  "$description": "Dogxi Misty — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "dogxi-misty",
      "name": "Dogxi Misty",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Dogxi Misty.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2882,
          0.0221,
          277.5
        ],
        "alpha": 1,
        "hex": "#282a36"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.953,
          0.0067,
          115.7
        ],
        "alpha": 1,
        "hex": "#eff0eb"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.937,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#eaeaea"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7718,
          0.0531,
          228.7
        ],
        "alpha": 1,
        "hex": "#92bcd0"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6902,
              0.1993,
              25.5
            ],
            "alpha": 1,
            "hex": "#ff5c57"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8375,
              0.1809,
              135
            ],
            "alpha": 1,
            "hex": "#94e362"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8262,
              0.1106,
              77.6
            ],
            "alpha": 1,
            "hex": "#eebd70"
