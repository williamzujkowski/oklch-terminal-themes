{
  "$description": "Birds Of Paradise — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "birds-of-paradise",
      "name": "Birds Of Paradise",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
