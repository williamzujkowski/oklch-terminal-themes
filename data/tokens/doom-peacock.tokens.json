    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.285,
          0.0056,
          91.6
        ],
        "alpha": 1,
        "hex": "#2b2a27"
      }
    },
