            ],
            "alpha": 1,
            "hex": "#aaaaaa"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7921,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bbbbbb"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8975,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#dddddd"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6268,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#888888"
          }
        },
        "purple": {
          "$value": {
