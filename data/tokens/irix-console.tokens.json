            "colorSpace": "oklch",
            "components": [
              0.5613,
              0.2092,
              26.9
            ],
            "alpha": 1,
            "hex": "#d42426"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.63,
              0.1866,
              141.3
            ],
            "alpha": 1,
            "hex": "#37a327"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7106,
