{
  "$description": "grafbase — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "grafbase",
      "name": "grafbase",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "warp-special-edition",
      "sourceUrl": "https://github.com/warpdotdev/themes/blob/82e51dcf9b47912d551107748ba3297a21b2eff3/special_edition/grafbase.yaml"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1867,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#131313"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4255,
          0.0687,
          206.1
        ],
        "alpha": 1,
        "hex": "#0d5961"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1867,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#131313"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
