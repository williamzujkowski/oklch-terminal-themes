    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1889,
          0.0062,
          236.9
        ],
        "alpha": 1,
        "hex": "#111416"
      }
    },
    "foreground": {
