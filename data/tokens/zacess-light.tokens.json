{
  "$description": "Zacess Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "zacess-light",
      "name": "Zacess Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/86a776d947b6f0c95d35005cb67f3cea435362fc/windowsterminal/Zacess Light.json",
      "counterpart": "zacess-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1776,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1776,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#111111"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9527,
          0.0929,
          98.6
        ],
        "alpha": 1,
        "hex": "#fff1a8"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1776,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#111111"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3163,
              0.1293,
              28
            ],
            "alpha": 1,
            "hex": "#640003"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2927,
              0.0924,
              144.9
            ],
            "alpha": 1,
            "hex": "#003708"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3031,
              0.0639,
              75
            ],
            "alpha": 1,
            "hex": "#412900"
          }
        },
        "blue": {
