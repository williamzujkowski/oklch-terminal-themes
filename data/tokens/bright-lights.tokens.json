    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2134,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#191919"
      }
    },
    "foreground": {
