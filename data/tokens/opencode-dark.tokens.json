            "colorSpace": "oklch",
            "components": [
              0.7231,
              0.0916,
              206.3
            ],
            "alpha": 1,
            "hex": "#56b6c2"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9491,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#eeeeee"
          }
        }
      },
      "bright": {
