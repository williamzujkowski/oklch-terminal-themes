{
  "$description": "OpenCode Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "opencode-dark",
      "name": "OpenCode Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/5fad1bde2d00c4eb9cb9264599ebb3d981eca4f0/windowsterminal/OpenCode Dark.json",
      "counterpart": "opencode-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9491,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#eeeeee"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8212,
          0.1045,
          53.9
        ],
        "alpha": 1,
        "hex": "#fab283"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2711,
          0.0603,
          52.8
        ],
        "alpha": 1,
        "hex": "#3d1d06"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.235,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#1e1e1e"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6709,
              0.1448,
              17
            ],
            "alpha": 1,
            "hex": "#e06c75"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8077,
              0.134,
              148.6
            ],
            "alpha": 1,
            "hex": "#7fd88f"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7874,
              0.1453,
              69.3
            ],
            "alpha": 1,
            "hex": "#f5a742"
          }
        },
        "blue": {
