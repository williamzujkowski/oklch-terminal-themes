{
  "$description": "Wong Colorblind-Safe Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "wong-colorblind-safe-dark",
      "name": "Wong Colorblind-Safe Dark",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-safe"
      ],
      "source": "native",
      "sourceUrl": "https://github.com/williamzujkowski/oklch-terminal-themes/blob/main/data-sources/native/wong-dark.json",
      "counterpart": "wong-colorblind-safe-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9702,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      }
