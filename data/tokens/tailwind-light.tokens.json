{
  "$description": "Tailwind Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "tailwind-light",
      "name": "Tailwind Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/Tailwind Light.json",
      "counterpart": "tailwind-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9851,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#fafafa"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9288,
          0.0126,
          255.5
        ],
        "alpha": 1,
        "hex": "#e2e8f0"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2686,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5054,
              0.1905,
              27.5
            ],
            "alpha": 1,
            "hex": "#b91c1c"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5273,
              0.1371,
              150.1
            ],
            "alpha": 1,
            "hex": "#15803d"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5538,
              0.1207,
              66.4
            ],
            "alpha": 1,
            "hex": "#a16207"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5,
