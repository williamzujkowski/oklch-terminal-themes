            "colorSpace": "oklch",
            "components": [
              0.5109,
              0.0861,
              186.4
            ],
            "alpha": 1,
            "hex": "#0f766e"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7889,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bababa"
          }
        }
      },
      "bright": {
