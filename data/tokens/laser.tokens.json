{
  "$description": "Laser — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "laser",
      "name": "Laser",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
