    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1547,
          0.0296,
          247.7
        ],
        "alpha": 1,
        "hex": "#030d18"
      }
    },
