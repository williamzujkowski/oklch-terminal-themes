{
  "$description": "Royal — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "royal",
      "name": "Royal",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "brightness-ordered",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
