    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1533,
          0.0299,
          311.7
        ],
        "alpha": 1,
        "hex": "#100815"
      }
    },
