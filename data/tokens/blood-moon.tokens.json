    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2689,
          0.0969,
          23.4
        ],
        "alpha": 1,
        "hex": "#4b080d"
      }
    },
