    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.209,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#181818"
      }
    },
