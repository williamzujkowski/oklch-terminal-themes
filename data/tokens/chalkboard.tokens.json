{
  "$description": "Chalkboard — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "chalkboard",
      "name": "Chalkboard",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Chalkboard.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2756,
          0.0169,
          300.5
        ],
        "alpha": 1,
        "hex": "#29262f"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9187,
          0.0215,
          245.9
        ],
        "alpha": 1,
        "hex": "#d9e6f2"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9187,
          0.0215,
          245.9
        ],
        "alpha": 1,
        "hex": "#d9e6f2"
      }
    },
    "selection": {
