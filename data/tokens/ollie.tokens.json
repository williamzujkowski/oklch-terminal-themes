{
  "$description": "Ollie — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "ollie",
      "name": "Ollie",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Ollie.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2505,
          0.0076,
          297.3
        ],
        "alpha": 1,
        "hex": "#222125"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6526,
          0.0491,
          280.9
        ],
        "alpha": 1,
        "hex": "#8a8dae"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5477,
          0.0922,
          269.2
        ],
        "alpha": 1,
        "hex": "#5b6ea7"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3509,
          0.0842,
          259.1
        ],
        "alpha": 1,
        "hex": "#1e3a66"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
