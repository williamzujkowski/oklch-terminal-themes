      "counterpart": "bauhaus-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2569,
          0.0211,
          60.3
        ],
        "alpha": 1,
        "hex": "#2b2119"
      }
    },
