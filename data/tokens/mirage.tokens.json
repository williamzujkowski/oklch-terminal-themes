    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2701,
          0.036,
          257.1
        ],
        "alpha": 1,
        "hex": "#1b2738"
      }
    },
