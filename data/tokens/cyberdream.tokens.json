{
  "$description": "Cyberdream — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "cyberdream",
      "name": "Cyberdream",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "cyberdream",
      "sourceUrl": "https://github.com/scottmckendry/cyberdream.nvim/blob/d0e6e837b0248e3507f3a295deb4661221610e78/extras/windowsterminal/cyberdream.json",
      "counterpart": "cyberdream-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2077,
          0.005,
          248.1
        ],
        "alpha": 1,
        "hex": "#16181a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "selection": {
