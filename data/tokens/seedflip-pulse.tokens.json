            "components": [
              0.839,
              0.1231,
              195.1
            ],
            "alpha": 1,
            "hex": "#4fe3e3"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
