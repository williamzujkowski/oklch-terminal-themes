{
  "$description": "Isocon Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "isocon-dark",
      "name": "Isocon Dark",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/450b05ea0962456b424e5736aed0bec7fd147f28/windowsterminal/Isocon Dark.json",
      "counterpart": "isocon-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2378,
          0.0357,
          214
        ],
        "alpha": 1,
        "hex": "#062329"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6201,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#868686"
