{
  "$description": "Afterglow — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "afterglow",
      "name": "Afterglow",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Afterglow.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2478,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#212121"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8576,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d0d0d0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8576,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d0d0d0"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3092,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#303030"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1957,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#151515"
          }
        },
        "red": {
