{
  "$description": "Pencil Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "pencil-light",
      "name": "Pencil Light",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Pencil Light.json",
      "counterpart": "pencil-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9581,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f1f1f1"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3791,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#424242"
      }
    },
    "cursor": {
