{
  "$description": "Seoulbones Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "seoulbones-light",
      "name": "Seoulbones Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Seoulbones Light.json",
      "counterpart": "seoulbones-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9128,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e2e2e2"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4495,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#555555"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4495,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#555555"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8452,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cccccc"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
