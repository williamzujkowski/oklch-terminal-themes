{
  "$description": "Nvim Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "nvim-light",
      "name": "Nvim Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Nvim Light.json",
      "counterpart": "nvim-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9136,
          0.011,
          274.9
        ],
        "alpha": 1,
        "hex": "#e0e2ea"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2003,
          0.0105,
          268.2
        ],
        "alpha": 1,
        "hex": "#14161b"
      }
    },
