{
  "$description": "Dark+ — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "dark-plus",
      "name": "Dark+",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Dark+.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.235,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1e1e1e"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8452,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cccccc"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3587,
          0.008,
          255.5
        ],
        "alpha": 1,
        "hex": "#3a3d41"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5592,
              0.1927,
              26.1
            ],
            "alpha": 1,
            "hex": "#cd3131"
          }
        },
        "green": {
