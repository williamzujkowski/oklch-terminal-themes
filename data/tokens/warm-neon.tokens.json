    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3715,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#404040"
      }
    },
