{
  "$description": "Warm Neon — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "warm-neon",
      "name": "Warm Neon",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
