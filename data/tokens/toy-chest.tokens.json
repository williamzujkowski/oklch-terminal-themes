    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3273,
          0.0443,
          252.9
        ],
        "alpha": 1,
        "hex": "#24364b"
      }
    },
