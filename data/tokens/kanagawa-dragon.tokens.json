{
  "$description": "Kanagawa Dragon — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "kanagawa-dragon",
      "name": "Kanagawa Dragon",
      "isDark": true,
