            "colorSpace": "oklch",
            "components": [
              0.7961,
              0.1125,
              200.9
            ],
            "alpha": 1,
            "hex": "#50d2da"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9067,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#e0e0e0"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
