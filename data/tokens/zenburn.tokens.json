    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3677,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#3f3f3f"
      }
    },
