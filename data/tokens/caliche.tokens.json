{
  "$description": "Caliche — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "caliche",
      "name": "Caliche",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
