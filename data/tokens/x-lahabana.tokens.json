{
  "$description": "X Lahabana — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "x-lahabana",
      "name": "X Lahabana",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
