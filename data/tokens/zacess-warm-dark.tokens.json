    "dev.oklch-terminal-themes": {
      "slug": "zacess-warm-dark",
      "name": "Zacess Warm Dark",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
