{
  "$description": "base16-icy — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "base16-icy",
      "name": "base16-icy",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "cursor-visible",
        "cvd-caution"
