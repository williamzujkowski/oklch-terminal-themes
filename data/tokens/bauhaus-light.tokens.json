{
  "$description": "Bauhaus Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "bauhaus-light",
      "name": "Bauhaus Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/5fad1bde2d00c4eb9cb9264599ebb3d981eca4f0/windowsterminal/Bauhaus Light.json",
      "counterpart": "bauhaus-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8972,
          0.0155,
          61.3
        ],
        "alpha": 1,
        "hex": "#e5dbd3"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2569,
          0.0211,
          60.3
        ],
        "alpha": 1,
        "hex": "#2b2119"
      }
    },
    "cursor": {
