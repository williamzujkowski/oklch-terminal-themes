{
  "$description": "AlxPro Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "alxpro-light",
      "name": "AlxPro Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/3d8a6a1a983d7fe721aa6cb9a5b98066cd74303a/windowsterminal/AlxPro Light.json",
      "counterpart": "alxpro-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2046,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#171717"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9249,
          0.0282,
          251.5
        ],
        "alpha": 1,
        "hex": "#d9e8f9"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2046,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#171717"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5498,
              0.1964,
              25.6
            ],
            "alpha": 1,
            "hex": "#cb2a2e"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5142,
              0.1256,
              147.6
            ],
            "alpha": 1,
            "hex": "#287a3a"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5279,
              0.1313,
              54.6
            ],
            "alpha": 1,
            "hex": "#a35200"
          }
        },
        "blue": {
