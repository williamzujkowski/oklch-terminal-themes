    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1834,
          0.0239,
          215.4
        ],
        "alpha": 1,
        "hex": "#051519"
      }
    },
