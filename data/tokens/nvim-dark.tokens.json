{
  "$description": "Nvim Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "nvim-dark",
      "name": "Nvim Dark",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Nvim Dark.json",
      "counterpart": "nvim-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2003,
          0.0105,
          268.2
        ],
        "alpha": 1,
        "hex": "#14161b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9136,
          0.011,
          274.9
        ],
        "alpha": 1,
        "hex": "#e0e2ea"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6987,
          0.0094,
          264.5
        ],
        "alpha": 1,
        "hex": "#9b9ea4"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.438,
          0.0106,
          264.5
        ],
        "alpha": 1,
        "hex": "#4f5258"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
