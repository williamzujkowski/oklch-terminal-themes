{
  "$description": "Ciapre — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "ciapre",
      "name": "Ciapre",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
