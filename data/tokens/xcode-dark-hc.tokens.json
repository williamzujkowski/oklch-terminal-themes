{
  "$description": "Xcode Dark hc — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "xcode-dark-hc",
      "name": "Xcode Dark hc",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Xcode Dark hc.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2414,
          0.0095,
          285.7
        ],
        "alpha": 1,
        "hex": "#1f1f24"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
