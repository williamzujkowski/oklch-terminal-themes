{
  "$description": "Oxblood — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "oxblood",
      "name": "Oxblood",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
