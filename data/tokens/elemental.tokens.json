{
  "$description": "Elemental — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "elemental",
      "name": "Elemental",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa-large",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Elemental.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2474,
          0.0075,
          95.4
        ],
        "alpha": 1,
        "hex": "#22211d"
      }
    },
