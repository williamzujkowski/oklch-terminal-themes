{
  "$description": "Arizona Monsoon — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "arizona-monsoon",
      "name": "Arizona Monsoon",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
