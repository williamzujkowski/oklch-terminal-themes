{
  "$description": "Andromeda — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "andromeda",
      "name": "Andromeda",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Andromeda.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2849,
          0.0175,
          266.3
        ],
        "alpha": 1,
        "hex": "#262a33"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9219,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e5e5e5"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9769,
          0.0105,
          106.6
        ],
        "alpha": 1,
        "hex": "#f8f8f0"
      }
    },
    "selection": {
