{
  "$description": "cyberpunk-icy — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "cyberpunk-icy",
      "name": "cyberpunk-icy",
      "isDark": true,
      "tags": [
        "dark",
        "vibrant",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
