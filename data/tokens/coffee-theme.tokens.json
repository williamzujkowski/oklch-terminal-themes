            "colorSpace": "oklch",
            "components": [
              0.7093,
              0.1208,
              196.2
            ],
            "alpha": 1,
            "hex": "#00b8ba"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.709,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#a1a1a1"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5173,
