{
  "$description": "No Clown Fiesta Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "no-clown-fiesta-light",
      "name": "No Clown Fiesta Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
