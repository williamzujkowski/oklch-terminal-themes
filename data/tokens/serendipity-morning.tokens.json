{
  "$description": "Serendipity Morning — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "serendipity-morning",
      "name": "Serendipity Morning",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
