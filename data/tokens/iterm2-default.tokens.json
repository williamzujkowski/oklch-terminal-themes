            "alpha": 1,
            "hex": "#5ffa68"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9663,
              0.1676,
              108.1
            ],
            "alpha": 1,
            "hex": "#fffc67"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
