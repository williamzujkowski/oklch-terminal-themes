{
  "$description": "Mellifluous — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "mellifluous",
      "name": "Mellifluous",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Mellifluous.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2178,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1a1a1a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8884,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#dadada"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7588,
          0.0296,
          62.2
        ],
        "alpha": 1,
        "hex": "#bfad9e"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2972,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#2d2d2d"
      }
    },
