    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2655,
          0.0792,
          295.1
        ],
        "alpha": 1,
        "hex": "#291b47"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9219,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e5e5e5"
      }
