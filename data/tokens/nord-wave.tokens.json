{
  "$description": "Nord Wave — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "nord-wave",
      "name": "Nord Wave",
      "isDark": true,
      "tags": [
        "dark",
