            "colorSpace": "oklch",
            "components": [
              0.5401,
              0.1146,
              120.3
            ],
            "alpha": 1,
            "hex": "#66781e"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8047,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bfbfbf"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
