{
  "$description": "Rainbows and Unicorns — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "rainbows-and-unicorns",
      "name": "Rainbows and Unicorns",
      "isDark": true,
