{
  "$description": "thanksgiving — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "thanksgiving",
      "name": "thanksgiving",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "warp-special-edition",
      "sourceUrl": "https://github.com/warpdotdev/themes/blob/82e51dcf9b47912d551107748ba3297a21b2eff3/special_edition/thanksgiving.yaml"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2768,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#282828"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9491,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#eeeeee"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8756,
          0.0506,
          223.9
        ],
        "alpha": 1,
        "hex": "#b3deef"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2768,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#282828"
      }
    },
