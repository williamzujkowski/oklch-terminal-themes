{
  "$description": "Tomorrow — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "tomorrow",
      "name": "Tomorrow",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution",
        "popular"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Tomorrow.json",
      "counterpart": "tomorrow-night"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4199,
          0.0016,
          106.5
        ],
        "alpha": 1,
        "hex": "#4d4d4c"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4199,
          0.0016,
          106.5
        ],
        "alpha": 1,
        "hex": "#4d4d4c"
      }
    },
    "selection": {
