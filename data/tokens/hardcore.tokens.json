{
  "$description": "Hardcore — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "hardcore",
      "name": "Hardcore",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Hardcore.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1822,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#121212"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7058,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#a0a0a0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7921,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bbbbbb"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3621,
          0.0145,
          31.2
        ],
        "alpha": 1,
        "hex": "#453b39"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
