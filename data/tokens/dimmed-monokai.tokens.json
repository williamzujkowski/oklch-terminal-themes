{
  "$description": "Dimmed Monokai — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "dimmed-monokai",
      "name": "Dimmed Monokai",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
