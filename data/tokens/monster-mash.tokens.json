{
  "$description": "Monster Mash — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "monster-mash",
      "name": "Monster Mash",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/86a776d947b6f0c95d35005cb67f3cea435362fc/windowsterminal/Monster Mash.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3143,
          0.0837,
          139.6
        ],
        "alpha": 1,
        "hex": "#173b0d"
      }
    },
    "foreground": {
