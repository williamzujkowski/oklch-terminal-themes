{
  "$description": "Carbonfox — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "carbonfox",
      "name": "Carbonfox",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Carbonfox.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2002,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#161616"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9668,
          0.0058,
          264.5
        ],
        "alpha": 1,
        "hex": "#f2f4f8"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9668,
          0.0058,
          264.5
        ],
        "alpha": 1,
        "hex": "#f2f4f8"
      }
    },
    "selection": {
