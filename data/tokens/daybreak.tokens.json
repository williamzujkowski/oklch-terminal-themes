{
  "$description": "Daybreak — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "daybreak",
      "name": "Daybreak",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
