      "counterpart": "melange-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9581,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f1f1f1"
      }
    },
    "foreground": {
