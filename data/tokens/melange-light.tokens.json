{
  "$description": "Melange Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "melange-light",
      "name": "Melange Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
