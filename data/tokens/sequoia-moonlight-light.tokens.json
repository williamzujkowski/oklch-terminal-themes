{
  "$description": "Sequoia Moonlight Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "sequoia-moonlight-light",
      "name": "Sequoia Moonlight Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
