    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.212,
          0.0134,
          258.4
        ],
        "alpha": 1,
        "hex": "#15191f"
      }
    },
    "foreground": {
