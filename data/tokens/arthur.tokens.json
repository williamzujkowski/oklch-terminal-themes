        "colorSpace": "oklch",
        "components": [
          0.8426,
          0.0824,
          317.6
        ],
        "alpha": 1,
        "hex": "#e2bbef"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4202,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4d4d4d"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
