{
  "$description": "Guezwhoz — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "guezwhoz",
      "name": "Guezwhoz",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Guezwhoz.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2308,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1d1d1d"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8853,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d9d9d9"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8199,
          0.0782,
          158.1
        ],
        "alpha": 1,
        "hex": "#99d4b1"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4102,
          0.051,
          197.2
        ],
        "alpha": 1,
        "hex": "#245354"
      }
    },
