{
  "$description": "Cyberdream Muted — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "cyberdream-muted",
      "name": "Cyberdream Muted",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "cyberdream",
      "sourceUrl": "https://github.com/scottmckendry/cyberdream.nvim/blob/d0e6e837b0248e3507f3a295deb4661221610e78/extras/windowsterminal/cyberdream-muted.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2077,
          0.005,
          248.1
        ],
        "alpha": 1,
        "hex": "#16181a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
