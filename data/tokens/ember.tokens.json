{
  "$description": "Ember — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "ember",
      "name": "Ember",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/Ember.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1837,
          0.0221,
          39.2
        ],
        "alpha": 1,
        "hex": "#1b0f0b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9238,
          0.0297,
          70.7
        ],
        "alpha": 1,
        "hex": "#f3e3d1"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6634,
          0.1325,
          53.5
        ],
        "alpha": 1,
        "hex": "#d17a3c"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3227,
          0.0522,
          41.2
        ],
        "alpha": 1,
        "hex": "#4a2a1e"
      }
    },
