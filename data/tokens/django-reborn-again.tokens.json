            ],
            "alpha": 1,
            "hex": "#9df39f"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
