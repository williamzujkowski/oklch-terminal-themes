{
  "$description": "Django Reborn Again — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "django-reborn-again",
      "name": "Django Reborn Again",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Django Reborn Again.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2151,
          0.0393,
          162.6
        ],
        "alpha": 1,
        "hex": "#051f14"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8969,
          0.0051,
          165
        ],
        "alpha": 1,
        "hex": "#dadedc"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8652,
          0.1768,
          90.4
        ],
        "alpha": 1,
        "hex": "#ffcc00"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3123,
          0.0409,
          153.2
        ],
        "alpha": 1,
        "hex": "#203727"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6879,
              0.2048,
              42.1
            ],
            "alpha": 1,
            "hex": "#fd6209"
          }
        },
        "green": {
