            "colorSpace": "oklch",
            "components": [
              0.6486,
              0.1732,
              142.8
            ],
            "alpha": 1,
            "hex": "#41a83e"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9252,
              0.1534,
              99.6
            ],
            "alpha": 1,
            "hex": "#ffe862"
          }
        },
        "blue": {
