{
  "$description": "Slate — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "slate",
      "name": "Slate",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Slate.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.252,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#222222"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7078,
          0.1147,
          219.9
        ],
        "alpha": 1,
        "hex": "#35b1d2"
      }
    },
    "cursor": {
