{
  "$description": "Citruszest — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "citruszest",
      "name": "Citruszest",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Citruszest.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1822,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#121212"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8047,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bfbfbf"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5103,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#666666"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7505,
          0.1791,
          58.3
        ],
        "alpha": 1,
        "hex": "#ff8c00"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3715,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#404040"
          }
