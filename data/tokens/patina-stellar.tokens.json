{
  "$description": "Patina Stellar — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "patina-stellar",
      "name": "Patina Stellar",
      "isDark": false,
      "tags": [
        "light",
