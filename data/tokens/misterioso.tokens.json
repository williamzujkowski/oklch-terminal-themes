{
  "$description": "Misterioso — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "misterioso",
      "name": "Misterioso",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Misterioso.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3327,
          0.0252,
          253.2
        ],
        "alpha": 1,
        "hex": "#2d3743"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9095,
          0.0013,
          106.4
        ],
        "alpha": 1,
        "hex": "#e1e1e0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5103,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#666666"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4993,
          0.2814,
          268.6
        ],
        "alpha": 1,
        "hex": "#2d37ff"
      }
    },
