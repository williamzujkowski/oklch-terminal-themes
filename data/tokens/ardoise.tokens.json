        "colorSpace": "oklch",
        "components": [
          0.9761,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f7f7f7"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4303,
          0.0258,
          252.7
        ],
        "alpha": 1,
        "hex": "#46515e"
      }
    },
