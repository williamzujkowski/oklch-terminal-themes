{
  "$description": "Clear Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "clear-light",
      "name": "Clear Light",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Clear Light.json",
      "counterpart": "clear-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.393,
          0.0236,
          236.4
        ],
        "alpha": 1,
        "hex": "#3a4851"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6567,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#919191"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9392,
          0.0101,
          238.5
        ],
        "alpha": 1,
        "hex": "#e5ecf1"
      }
    },
