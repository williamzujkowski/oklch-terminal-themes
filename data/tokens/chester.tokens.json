            "colorSpace": "oklch",
            "components": [
              0.6854,
              0.1916,
              24.7
            ],
            "alpha": 1,
            "hex": "#fa5e5b"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7407,
              0.1577,
              162.6
            ],
            "alpha": 1,
            "hex": "#16c98d"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
