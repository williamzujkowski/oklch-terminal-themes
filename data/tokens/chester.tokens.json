{
  "$description": "Chester — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "chester",
      "name": "Chester",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Chester.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3293,
          0.0268,
          255.1
        ],
        "alpha": 1,
        "hex": "#2c3643"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7628,
          0.0034,
          17.2
        ],
        "alpha": 1,
        "hex": "#b4b1b1"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5509,
          0.02,
          234.8
        ],
        "alpha": 1,
        "hex": "#67747c"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.1002,
              0.0243,
              56.9
            ],
            "alpha": 1,
            "hex": "#080200"
          }
        },
        "red": {
