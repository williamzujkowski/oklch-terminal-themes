{
  "$description": "Darkmatrix — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "darkmatrix",
      "name": "Darkmatrix",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "cursor-visible",
        "cvd-caution"
