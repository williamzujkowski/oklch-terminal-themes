    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1496,
          0.0096,
          222.9
        ],
        "alpha": 1,
        "hex": "#070c0e"
      }
