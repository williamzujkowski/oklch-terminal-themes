{
  "$description": "Matrix — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "matrix",
      "name": "Matrix",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
