    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2051,
          0.0157,
          218.3
        ],
        "alpha": 1,
        "hex": "#0f191c"
      }
    },
