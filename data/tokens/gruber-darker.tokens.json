{
  "$description": "Gruber Darker — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "gruber-darker",
      "name": "Gruber Darker",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Gruber Darker.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.209,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#181818"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9189,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e4e4e4"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8947,
          0.1845,
          97
        ],
        "alpha": 1,
        "hex": "#ffdb00"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.209,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#181818"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6327,
              0.2529,
              23.3
            ],
            "alpha": 1,
            "hex": "#ff0a36"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7828,
              0.2532,
              140.2
            ],
            "alpha": 1,
            "hex": "#42dc00"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8947,
              0.1845,
              97
            ],
            "alpha": 1,
            "hex": "#ffdb00"
          }
        },
        "blue": {
