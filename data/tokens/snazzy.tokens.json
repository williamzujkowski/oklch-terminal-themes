            "colorSpace": "oklch",
            "components": [
              0.883,
              0.0938,
              213.7
            ],
            "alpha": 1,
            "hex": "#8be9fe"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9458,
              0.0013,
              106.4
            ],
            "alpha": 1,
            "hex": "#ededec"
          }
        }
      },
      "bright": {
