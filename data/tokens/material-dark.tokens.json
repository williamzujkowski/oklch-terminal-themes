      "counterpart": "material"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2558,
          0.0018,
          106.5
        ],
        "alpha": 1,
        "hex": "#232322"
      }
    },
