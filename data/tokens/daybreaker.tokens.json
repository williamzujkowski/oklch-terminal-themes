{
  "$description": "Daybreaker — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "daybreaker",
      "name": "Daybreaker",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/450b05ea0962456b424e5736aed0bec7fd147f28/windowsterminal/Daybreaker.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9878,
          0.0075,
          61.5
        ],
        "alpha": 1,
        "hex": "#fffaf6"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.235,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#1e1e1e"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.479,
          0.1124,
          59.9
        ],
        "alpha": 1,
        "hex": "#8a4b00"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9104,
          0.0129,
          86.8
        ],
        "alpha": 1,
        "hex": "#e5e1d8"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2809,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#292929"
          }
        },
        "red": {
