    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2737,
          0.0109,
          114.8
        ],
        "alpha": 1,
        "hex": "#272822"
      }
    },
