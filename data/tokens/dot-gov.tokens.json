{
  "$description": "Dot Gov — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "dot-gov",
      "name": "Dot Gov",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "cvd-safe"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Dot Gov.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2911,
          0.0185,
          258.4
        ],
        "alpha": 1,
        "hex": "#262c35"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9401,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ebebeb"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5589,
          0.2253,
          22.4
        ],
        "alpha": 1,
        "hex": "#d9002f"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3826,
          0.1167,
          260.2
        ],
        "alpha": 1,
        "hex": "#1a4080"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2134,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#191919"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5092,
              0.2032,
              25.7
            ],
            "alpha": 1,
            "hex": "#bf091d"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6045,
              0.1351,
              148.3
            ],
            "alpha": 1,
            "hex": "#3d9751"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8248,
              0.1553,
              83.1
            ],
            "alpha": 1,
            "hex": "#f6bb34"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7117,
              0.1319,
              225.5
            ],
            "alpha": 1,
            "hex": "#17b2e0"
          }
        },
        "purple": {
