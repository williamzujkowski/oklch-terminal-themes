            "colorSpace": "oklch",
            "components": [
              0.476,
              0.1934,
              305.9
            ],
            "alpha": 1,
            "hex": "#7830b0"
          }
        },
        "cyan": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8264,
              0.0804,
              224
            ],
            "alpha": 1,
            "hex": "#8bd2ed"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              1,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#ffffff"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
