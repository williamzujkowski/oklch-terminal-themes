{
  "$description": "Urple — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "urple",
      "name": "Urple",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-aa-large",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
