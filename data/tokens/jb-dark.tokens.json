      "counterpart": "jb-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2175,
          0.0042,
          264.5
        ],
        "alpha": 1,
        "hex": "#191a1c"
      }
    },
    "foreground": {
