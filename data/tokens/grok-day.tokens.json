{
  "$description": "Grok Day — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "grok-day",
      "name": "Grok Day",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/Grok Day.json",
      "counterpart": "grok-night"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9702,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#f5f5f5"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2686,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#262626"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5327,
          0.1837,
          298.7
        ],
        "alpha": 1,
        "hex": "#7d4bc6"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9006,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#dedede"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2686,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#262626"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5619,
              0.1919,
              18
            ],
            "alpha": 1,
            "hex": "#cd3048"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5723,
              0.164,
              140.4
            ],
            "alpha": 1,
            "hex": "#378e23"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.5947,
              0.1178,
              81.2
            ],
            "alpha": 1,
            "hex": "#a27612"
          }
        },
        "blue": {
