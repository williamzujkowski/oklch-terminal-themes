{
  "$description": "Front End Delight — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "front-end-delight",
      "name": "Front End Delight",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Front End Delight.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2258,
          0.0025,
          247.9
        ],
        "alpha": 1,
        "hex": "#1b1c1d"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7476,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#adadad"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8483,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#cdcdcd"
      }
    },
