{
  "$description": "Light Owl — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "light-owl",
      "name": "Light Owl",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Light Owl.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9881,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#fbfbfb"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3769,
          0.0339,
          286.9
        ],
        "alpha": 1,
        "hex": "#403f53"
      }
    },
