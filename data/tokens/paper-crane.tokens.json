    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9588,
          0.0127,
          86.8
        ],
        "alpha": 1,
        "hex": "#f5f1e8"
      }
    },
