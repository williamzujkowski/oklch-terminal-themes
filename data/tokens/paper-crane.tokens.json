{
  "$description": "Paper Crane — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "paper-crane",
      "name": "Paper Crane",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
