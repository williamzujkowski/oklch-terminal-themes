{
  "$description": "SeedFlip Inkwell — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "seedflip-inkwell",
      "name": "SeedFlip Inkwell",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/SeedFlip Inkwell.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1448,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#0a0a0a"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9206,
          0.008,
          73.7
        ],
        "alpha": 1,
        "hex": "#e8e4df"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7896,
          0.0376,
          78.1
        ],
        "alpha": 1,
        "hex": "#c8b8a0"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1913,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#141414"
      }
    },
