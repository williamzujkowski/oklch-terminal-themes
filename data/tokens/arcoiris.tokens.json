    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.24,
          0.0024,
          67.7
        ],
        "alpha": 1,
        "hex": "#201f1e"
      }
    },
