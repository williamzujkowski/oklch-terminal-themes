    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2164,
          0.0119,
          225.8
        ],
        "alpha": 1,
        "hex": "#141b1e"
      }
    },
