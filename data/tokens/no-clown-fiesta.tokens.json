{
  "$description": "No Clown Fiesta — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "no-clown-fiesta",
      "name": "No Clown Fiesta",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/No Clown Fiesta.json",
      "counterpart": "no-clown-fiesta-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.173,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#101010"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9098,
          0.0042,
          271.4
        ],
        "alpha": 1,
        "hex": "#e0e1e4"
      }
    },
