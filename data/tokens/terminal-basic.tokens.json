{
  "$description": "Terminal Basic — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "terminal-basic",
      "name": "Terminal Basic",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Terminal Basic.json",
      "counterpart": "terminal-basic-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5965,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#7f7f7f"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8284,
          0.0862,
          257.7
        ],
        "alpha": 1,
        "hex": "#a4c9ff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.4289,
              0.176,
              29.2
            ],
            "alpha": 1,
            "hex": "#990000"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6283,
              0.2138,
              142.5
            ],
            "alpha": 1,
            "hex": "#00a600"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6611,
              0.1441,
              109.8
            ],
            "alpha": 1,
            "hex": "#999900"
          }
        },
        "blue": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.3451,
              0.2392,
              264.1
            ],
            "alpha": 1,
            "hex": "#0000b2"
