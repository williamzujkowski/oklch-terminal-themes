            "colorSpace": "oklch",
            "components": [
              0.6611,
              0.1127,
              203.9
            ],
            "alpha": 1,
            "hex": "#00a6b2"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8047,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#bfbfbf"
          }
        }
      },
      "bright": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
