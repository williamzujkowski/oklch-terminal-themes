{
  "$description": "SilkCircuit — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "silkcircuit",
      "name": "SilkCircuit",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "silkcircuit",
      "sourceUrl": "https://github.com/hyperb1iss/silkcircuit/blob/7d1385d5f1da08ae751d575ddef4227edd6f8041/extras/windows-terminal.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1473,
          0.0107,
          285
        ],
        "alpha": 1,
        "hex": "#0a0a0f"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9067,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e0e0e0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.6749,
          0.2902,
          321
        ],
        "alpha": 1,
        "hex": "#e135ff"
      }
    },
    "selection": {
