{
  "$description": "Thermal Receipt — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "thermal-receipt",
      "name": "Thermal Receipt",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/450b05ea0962456b424e5736aed0bec7fd147f28/windowsterminal/Thermal Receipt.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9939,
          0.0082,
          91.5
        ],
        "alpha": 1,
        "hex": "#fffdf7"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2134,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#191919"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3211,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#333333"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9165,
          0.0128,
          86.8
        ],
        "alpha": 1,
        "hex": "#e7e3da"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.2809,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#292929"
          }
        },
        "red": {
