    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2723,
          0.0106,
          17.8
        ],
        "alpha": 1,
        "hex": "#2c2525"
      }
    },
