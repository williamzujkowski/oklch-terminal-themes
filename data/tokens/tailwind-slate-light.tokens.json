{
  "$description": "Tailwind Slate Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "tailwind-slate-light",
      "name": "Tailwind Slate Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "native",
      "sourceUrl": "https://github.com/williamzujkowski/oklch-terminal-themes/blob/main/data-sources/native/tailwind-slate-light.json",
      "counterpart": "tailwind-slate-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9842,
          0.0034,
          247.9
        ],
        "alpha": 1,
        "hex": "#f8fafc"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1288,
          0.0406,
          264.7
        ],
        "alpha": 1,
        "hex": "#020617"
      }
    },
