{
  "$description": "Spiderman — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "spiderman",
      "name": "Spiderman",
      "isDark": true,
      "tags": [
        "dark",
        "vibrant",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Spiderman.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.229,
          0.0036,
          229
        ],
        "alpha": 1,
        "hex": "#1b1d1e"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9158,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e3e3e3"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5087,
          0.275,
          268
        ],
        "alpha": 1,
        "hex": "#2c3fff"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2214,
          0.1173,
          268.1
        ],
        "alpha": 1,
        "hex": "#070e50"
      }
    },
