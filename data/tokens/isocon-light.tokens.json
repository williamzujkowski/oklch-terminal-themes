{
  "$description": "Isocon Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "isocon-light",
      "name": "Isocon Light",
      "isDark": false,
      "tags": [
        "light",
        "low-contrast",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/31756e77934045c66b28f59463ddb2870606d7ca/windowsterminal/Isocon Light.json",
      "counterpart": "isocon-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9579,
          0.013,
          130.8
        ],
        "alpha": 1,
        "hex": "#eef3ea"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5382,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#6e6e6e"
      }
    },
    "cursor": {
