{
  "$description": "3024 Day — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "3024-day",
      "name": "3024 Day",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "cursor-visible",
        "cvd-safe"
