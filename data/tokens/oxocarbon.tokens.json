            ],
            "alpha": 1,
            "hex": "#ff74b8"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.9668,
              0.0058,
              264.5
            ],
            "alpha": 1,
