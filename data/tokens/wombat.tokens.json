            ],
            "alpha": 1,
            "hex": "#82fff7"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.8885,
              0.0155,
              90.2
            ],
            "alpha": 1,
            "hex": "#dedacf"
