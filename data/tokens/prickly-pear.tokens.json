{
  "$description": "Prickly Pear — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "prickly-pear",
      "name": "Prickly Pear",
      "isDark": true,
      "tags": [
        "dark",
        "high-contrast",
        "wcag-aaa",
