{
  "$description": "Sauber — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "sauber",
      "name": "Sauber",
      "isDark": false,
      "tags": [
        "light",
        "wcag-aa",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Sauber.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9791,
          0.0395,
          137.2
        ],
        "alpha": 1,
        "hex": "#ecffe5"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5009,
          0.2639,
          264.6
        ],
        "alpha": 1,
        "hex": "#1345f6"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8667,
          0.0677,
          251.3
        ],
        "alpha": 1,
        "hex": "#b3d7ff"
      }
    },
