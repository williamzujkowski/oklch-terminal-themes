{
  "$description": "Seoulbones Dark — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "seoulbones-dark",
      "name": "Seoulbones Dark",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Seoulbones Dark.json",
      "counterpart": "seoulbones-light"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4128,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4b4b4b"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8975,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#dddddd"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9128,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e2e2e2"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.5693,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#777777"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
