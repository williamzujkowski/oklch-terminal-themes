{
  "$description": "Whimsy — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "whimsy",
      "name": "Whimsy",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
