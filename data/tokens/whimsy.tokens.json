    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2867,
          0.0345,
          286.4
        ],
        "alpha": 1,
        "hex": "#29283b"
      }
    },
    "foreground": {
