{
  "$description": "Teerb — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "teerb",
      "name": "Teerb",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Teerb.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.2686,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#262626"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8576,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#d0d0d0"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8519,
          0.0465,
          66.1
        ],
        "alpha": 1,
        "hex": "#e4c9af"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4202,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#4d4d4d"
      }
    },
