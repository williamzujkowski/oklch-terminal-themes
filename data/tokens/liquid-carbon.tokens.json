{
  "$description": "Liquid Carbon — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "liquid-carbon",
      "name": "Liquid Carbon",
      "isDark": true,
      "tags": [
        "dark",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Liquid Carbon.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.3092,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#303030"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7996,
          0.0208,
          196.7
        ],
        "alpha": 1,
        "hex": "#afc2c2"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          1,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#ffffff"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7833,
          0.1147,
          249.5
        ],
        "alpha": 1,
        "hex": "#7dbeff"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#000000"
          }
        },
        "red": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6467,
              0.2391,
              27.2
            ],
            "alpha": 1,
            "hex": "#ff3030"
          }
        },
        "green": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.6288,
              0.0953,
              155.7
            ],
            "alpha": 1,
            "hex": "#559a70"
          }
        },
        "yellow": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.7504,
              0.1542,
              95.6
            ],
            "alpha": 1,
            "hex": "#ccac00"
          }
        },
        "blue": {
