            "colorSpace": "oklch",
            "components": [
              0.7748,
              0.0745,
              204.5
            ],
            "alpha": 1,
            "hex": "#7ac4cc"
          }
        },
        "white": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.833,
              0.0174,
              196.8
            ],
            "alpha": 1,
            "hex": "#bccccc"
          }
        }
      },
      "bright": {
