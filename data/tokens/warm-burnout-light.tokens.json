{
  "$description": "Warm Burnout Light — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "warm-burnout-light",
      "name": "Warm Burnout Light",
      "isDark": false,
      "tags": [
        "light",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "selection-legible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "warm-burnout",
      "sourceUrl": "https://github.com/felipefdl/warm-burnout/blob/1b84eb9e366d88cef5a285baa0047a6b123e95c9/windows-terminal/warm-burnout-light.json",
      "counterpart": "warm-burnout-dark"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9488,
          0.0193,
          80.1
        ],
        "alpha": 1,
        "hex": "#f5ede0"
      }
    },
    "foreground": {
