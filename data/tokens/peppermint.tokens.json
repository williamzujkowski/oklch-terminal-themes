{
  "$description": "Peppermint — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "peppermint",
      "name": "Peppermint",
      "isDark": true,
      "tags": [
        "dark",
        "muted",
        "high-contrast",
        "wcag-aaa",
        "wcag-aa",
        "ansi-legible",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Peppermint.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#000000"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.8328,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#c8c8c8"
      }
    },
    "cursor": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.7921,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#bbbbbb"
      }
    },
    "selection": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.9249,
          0,
          "none"
        ],
        "alpha": 1,
        "hex": "#e6e6e6"
      }
    },
    "ansi": {
      "$description": "The 16 ANSI slots, split into the normal and bright halves.",
      "normal": {
        "black": {
          "$value": {
            "colorSpace": "oklch",
            "components": [
              0.329,
              0,
              "none"
            ],
            "alpha": 1,
            "hex": "#353535"
          }
        },
        "red": {
