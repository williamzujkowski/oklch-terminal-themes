{
  "$description": "Shaman — terminal colour theme (dark).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "shaman",
      "name": "Shaman",
      "isDark": true,
      "tags": [
        "dark",
        "low-contrast",
        "wcag-fail",
        "cursor-visible",
        "brightness-ordered",
        "cvd-caution"
      ],
      "source": "iterm2-color-schemes",
      "sourceUrl": "https://github.com/mbadolato/iTerm2-Color-Schemes/blob/0173c3cc154aab5d43b03241286d32372a87dec6/windowsterminal/Shaman.json"
    }
  },
  "color": {
    "$type": "color",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.1595,
          0.0285,
          216.7
        ],
        "alpha": 1,
        "hex": "#001015"
      }
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [
          0.4322,
          0.0257,
          196.2
        ],
        "alpha": 1,
        "hex": "#405555"
