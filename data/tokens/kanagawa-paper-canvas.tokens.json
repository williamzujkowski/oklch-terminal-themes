{
  "$description": "Kanagawa Paper Canvas — terminal colour theme (light).",
  "$extensions": {
    "dev.oklch-terminal-themes": {
      "slug": "kanagawa-paper-canvas",
      "name": "Kanagawa Paper Canvas",
      "isDark": false,
      "tags": [
        "light",
        "muted",
        "low-contrast",
