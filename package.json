{
  "name": "@williamzujkowski/oklch-terminal-themes",
  "version": "0.10.0",
  "description": "908 terminal color schemes converted to OKLCH, with WCAG contrast data per theme — npm package + JSON API for Astro, Svelte, Tailwind v4, and theme pickers.",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "William Zujkowski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamzujkowski/oklch-terminal-themes.git"
  },
  "homepage": "https://github.com/williamzujkowski/oklch-terminal-themes#readme",
  "bugs": {
    "url": "https://github.com/williamzujkowski/oklch-terminal-themes/issues"
  },
  "keywords": [
    "oklch",
    "terminal",
    "colors",
    "themes",
    "ansi",
    "culori",
    "tailwind",
    "palette"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./themes.json": {
      "types": "./types/themes.json.d.ts",
      "default": "./data/themes.json"
    },
    "./themes-slim.json": {
      "types": "./types/themes-slim.json.d.ts",
      "default": "./data/themes-slim.json"
    },
    "./index.json": {
      "types": "./types/index.json.d.ts",
      "default": "./data/index.json"
    },
    "./themes/*.json": {
      "types": "./types/theme.json.d.ts",
      "default": "./data/by-name/*.json"
    },
    "./css/*.css": "./data/css/*.css",
    "./schemes/*.yaml": "./data/schemes/*.yaml",
    "./tokens/*.tokens.json": {
      "types": "./types/tokens.json.d.ts",
      "default": "./data/tokens/*.tokens.json"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "NOTICE",
    "types"
  ],
  "scripts": {
    "build:data": "tsx scripts/build.ts",
    "build:ts": "tsc -p tsconfig.json",
    "build": "pnpm build:data && pnpm build:ts",
    "update": "tsx scripts/fetch-upstream.ts && pnpm build:data",
    "validate": "tsx scripts/validate.ts",
    "verify:package": "tsx scripts/verify-package.ts",
    "sync-theme-count": "tsx scripts/sync-theme-count.ts",
    "sync-theme-count:check": "tsx scripts/sync-theme-count.ts --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"!**/node_modules/**\" \"!**/dist/**\" \"!**/data/**\" \"!**/upstream/**\" \"!**/coverage/**\" \"!**/.astro/**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,js,json,yml,yaml,md}": "prettier --write",
    "*.ts": "eslint --fix",
    "*.md": "markdownlint-cli2 --fix"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "dependencies": {
    "apca-w3": "^0.1.9",
    "culori": "^4.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@types/apca-w3": "^0.1.3",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "markdownlint-cli2": "^0.24.1",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
